import Proposal.GeometricHodgeEuler

/-!
# The Euler quotient of tangent coordinates on the original sextic

Subtracting the radial component makes the chosen weight-one component zero.
This gives a split surjection from tangent five-tuples onto the intrinsic
chart gradient kernel, with kernel the line generated by the Euler vector.
The quotient therefore gives all derivations of the normalized chart ring.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false
set_option Elab.async false

noncomputable section
namespace CycleQ2HodgeEuler

open MvPolynomial CycleQ2GenericSexticGradient
open CycleQ2HodgeEulerChartDerivations

section Split

variable {A : Type*} [CommRing A] {n : ℕ}

/-- Contraction with a gradient row. -/
def pairing (g : Fin n → A) : (Fin n → A) →ₗ[A] A := ∑ j, g j • LinearMap.proj j

theorem pairing_apply (g v : Fin n → A) : pairing g v = ∑ j, g j * v j := by simp [pairing]

variable (p : Fin (n+1)) (g r : Fin (n+1) → A)

def normalize : (Fin (n+1) → A) →ₗ[A] (Fin n → A) where
  toFun v j := v (p.succAbove j) - v p * r (p.succAbove j)
  map_add' a b := by ext j; simp [add_mul]; ring
  map_smul' c v := by ext j; simp [mul_sub, mul_assoc]

def insertZero (w : Fin n → A) : Fin (n+1) → A := p.insertNth 0 w

theorem normalize_insertZero (w : Fin n → A) : normalize p r (insertZero p w) = w := by
  funext j
  simp [normalize, insertZero]

theorem normalize_radial (h : r p = 1) : normalize p r r = 0 := by
  funext j
  simp [normalize, h]

theorem reconstruct (h : r p = 1) (v : Fin (n+1) → A) :
    insertZero p (normalize p r v) + v p • r = v := by
  funext j
  refine Fin.succAboveCases p ?_ (fun a => ?_) j
  · simp [insertZero, h]
  · simp [normalize, insertZero]

theorem pairing_insertZero (w : Fin n → A) :
    pairing g (insertZero p w) = pairing (g ∘ p.succAbove) w := by
  rw [pairing_apply, Fin.sum_univ_succAbove _ p]
  simp [insertZero, pairing_apply]

variable (h₁ : r p = 1) (h₀ : pairing g r = 0)

/-- The radial line inside the actual ambient tangent kernel. -/
def radialMap : A →ₗ[A] (pairing g).ker :=
  LinearMap.toSpanSingleton A _ (⟨r, h₀⟩ : (pairing g).ker)

def tangentProjection : (pairing g).ker →ₗ[A] (pairing (g ∘ p.succAbove)).ker :=
  ((normalize p r).comp (pairing g).ker.subtype).codRestrict _ (fun v => by
    rw [LinearMap.mem_ker]
    change pairing (g ∘ p.succAbove) (normalize p r v.val) = 0
    rw [← pairing_insertZero]
    have hh := congrArg (pairing g) (reconstruct p r h₁ v.val)
    simpa only [map_add, map_smul, h₀, smul_zero, add_zero] using hh.trans v.property)

theorem tangentProjection_surj : Function.Surjective (tangentProjection p g r h₁ h₀) := by
  intro w
  refine ⟨⟨insertZero p w.val, (pairing_insertZero p g w.val).trans w.property⟩, ?_⟩
  exact Subtype.ext (normalize_insertZero p r w.val)

theorem radial_range_eq_ker :
    (radialMap g r h₀).range = (tangentProjection p g r h₁ h₀).ker := by
  ext v
  constructor
  · rintro ⟨a, rfl⟩
    apply Subtype.ext
    change normalize p r (a • r) = 0
    rw [map_smul, normalize_radial p r h₁, smul_zero]
  · intro hv
    refine ⟨v.val p, ?_⟩
    apply Subtype.ext
    have ht : normalize p r v.val = 0 := congrArg Subtype.val hv
    have hz : insertZero p (0 : Fin n → A) = 0 := by
      funext j
      refine Fin.succAboveCases p ?_ (fun a => ?_) j <;> simp [insertZero]
    have h := reconstruct p r h₁ v.val
    rw [ht, hz, zero_add] at h
    exact h

def quotientEquiv :
    ((pairing g).ker ⧸ (radialMap g r h₀).range) ≃ₗ[A] (pairing (g ∘ p.succAbove)).ker :=
  (Submodule.quotEquivOfEq _ _ (radial_range_eq_ker p g r h₁ h₀)).trans
    ((tangentProjection p g r h₁ h₀).quotKerEquivOfSurjective (tangentProjection_surj p g r h₁ h₀))

theorem quotientEquiv_mk (v : (pairing g).ker) :
    quotientEquiv p g r h₁ h₀ (Submodule.Quotient.mk v) = tangentProjection p g r h₁ h₀ v := by
  simp only [quotientEquiv, LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivOfSurjective_apply_mk]

end Split

section Family

variable {R : Type*} [CommRing R] (φ : CoeffRing →+* R) (i : Fin 4)

theorem chartEuler : pairing (conePartial φ i) (radial φ i) = 0 :=
  (pairing_apply _ _).trans (radial_equation φ i)

theorem retained_gradient : pairing (conePartial φ i ∘ i.castSucc.succAbove) = gradient (F φ i) := by
  apply LinearMap.ext
  intro v
  rw [pairing_apply, gradient_apply]
  simp only [Function.comp_apply, partial_succAbove, chartMap]

abbrev RawTangent := (pairing (conePartial φ i)).ker

abbrev EulerLine := (radialMap (conePartial φ i) (radial φ i) (chartEuler φ i)).range

/-- Intrinsic vector fields are precisely the ambient tangent five-tuples modulo the weighted
Euler direction. This holds on every standard weight-one chart of every fiber. -/
def tangentQuotientEquiv : (RawTangent φ i ⧸ EulerLine φ i) ≃ₗ[chart φ i]
    Derivation R (chart φ i) (chart φ i) :=
  (quotientEquiv i.castSucc (conePartial φ i) (radial φ i) (radial_self φ i) (chartEuler φ i)).trans
    ((LinearEquiv.ofEq _ _ (congrArg LinearMap.ker (retained_gradient φ i))).trans
      (derivationEquiv (F φ i)).symm)

/-- The chart-coordinate value of the derivation determined by an ambient tuple. -/
theorem tangentQuotientEquiv_coordinate (v : RawTangent φ i) (j : Fin 4) :
    tangentQuotientEquiv φ i (Submodule.Quotient.mk v) (chartMap φ i (X j)) =
      v.val (i.castSucc.succAbove j) - v.val i.castSucc * radial φ i (i.castSucc.succAbove j) := by
  change tangentQuotientEquiv φ i (Submodule.Quotient.mk v) (mk (F φ i) (X j)) = _
  rw [← derivationEquiv_apply]
  simp only [tangentQuotientEquiv, LinearEquiv.trans_apply, LinearEquiv.apply_symm_apply,
    quotientEquiv_mk]
  rfl

end Family
end CycleQ2HodgeEuler
end

#print axioms CycleQ2HodgeEuler.radial_range_eq_ker
#print axioms CycleQ2HodgeEuler.tangentQuotientEquiv_coordinate
