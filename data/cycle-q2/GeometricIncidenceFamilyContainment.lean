/-!
# The actual incidence family in the weighted sextic hypersurface

The source remains the existing projective zero locus `genericCurve y`,
defined by the homogeneous equations `(h,F,M*T)` over `S[T0,T1,T2]`.
The target below is the literal F-only weighted projective hypersurface
over S. The coefficient-extension morphism forgets only the three section
parameters; it does not change the geometric coordinates or sextic.

The ambient triangles are identities of actual scheme morphisms. The
trace-family sextic is the original universal sextic, independent of the
incidence-solving coordinates and the section parameters. None of these
statements asserts smoothness, flatness, dimension, or a cycle-class map.

Status: source-only proof draft. Verification is deferred at the user's
request. No new axioms or admissions are used.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2IncidenceFamilyContainment

open CategoryTheory AlgebraicGeometry MvPolynomial
open CycleQ2IncidenceNormalForm CycleQ2IncidenceUniversalChart
  CycleQ2IncidenceGenericPointSemantics CycleQ2IncidenceImageLine
  CycleQ2GeometricIncidenceProj

attribute [local instance] MvPolynomial.weightedGradedAlgebra

section ProjectiveCoefficientNaturality

variable {A B σ τ : Type} [CommRing A] [CommRing B]
  [SetLike σ A] [SetLike τ B] [AddSubgroupClass σ A] [AddSubgroupClass τ B]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]

theorem awayMap_fromZero (f : 𝒜 →+*ᵍ ℬ) (s : A) (a : 𝒜 0) :
    HomogeneousLocalization.Away.map f s
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers s) a) =
      HomogeneousLocalization.fromZeroRingHom ℬ (Submonoid.powers (f s))
        (f.gradedZeroRingHom a) := by
  change HomogeneousLocalization.map f _
      (HomogeneousLocalization.mk ⟨0,a,1,by simp⟩) =
    HomogeneousLocalization.mk ⟨0,f.gradedZeroRingHom a,1,by simp⟩
  rw [HomogeneousLocalization.map_mk]
  apply congrArg HomogeneousLocalization.mk
  apply HomogeneousLocalization.NumDenSameDeg.ext _ rfl rfl
  exact map_one f

/-- Naturality of the actual map to the degree-zero affine base. -/
theorem projectiveMap_toSpecZero (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f) :
    Proj.map f hf ≫ Proj.toSpecZero 𝒜 =
      Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom f.gradedZeroRingHom) := by
  refine (Proj.mapAffineOpenCover f hf).openCover.hom_ext _ _ fun s => ?_
  simp only [Scheme.AffineOpenCover.openCover_f, Proj.mapAffineOpenCover_f,
    Category.assoc]
  rw [Proj.awayι_comp_map_assoc f hf s.1.2 _ s.2.2,
    Proj.awayι_toSpecZero, Proj.awayι_toSpecZero_assoc,
    ← Spec.map_comp, ← Spec.map_comp]
  congr 1
  ext a
  exact awayMap_fromZero f s.2 a

theorem projectiveMap_coefficientBase {R : Type} [CommRing R]
    (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f)
    (cA : R →+* 𝒜 0) (cB : R →+* ℬ 0)
    (hc : f.gradedZeroRingHom.comp cA = cB) :
    Proj.map f hf ≫ (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom cA)) =
      Proj.toSpecZero ℬ ≫ Spec.map (CommRingCat.ofHom cB) := by
  rw [← Category.assoc, projectiveMap_toSpecZero, Category.assoc, ← Spec.map_comp]
  change Proj.toSpecZero ℬ ≫
      Spec.map (CommRingCat.ofHom (f.gradedZeroRingHom.comp cA)) = _
  rw [hc]

end ProjectiveCoefficientNaturality

theorem geometricWeight_pos (i : Fin 5) : 0 < geometricWeight i := by
  fin_cases i <;> norm_num [geometricWeight]

/-- A positive homogeneous polynomial has no constant monomial, and hence
belongs to the ideal generated by the actual geometric variables. -/
theorem homogeneous_mem_variableIdeal {R : Type} [CommRing R]
    {n : ℕ} (hn : 0 < n) {p : MvPolynomial (Fin 5) R}
    (hp : p ∈ PolynomialGrade R n) :
    p ∈ Ideal.span (Set.range (X : Fin 5 → MvPolynomial (Fin 5) R)) := by
  rw [← Set.image_univ]
  apply mem_ideal_span_X_image.mpr
  intro e he
  have he0 : e ≠ 0 := by
    intro h
    have hd := hp (mem_support_iff.mp he)
    simp only [h, map_zero] at hd
    omega
  obtain ⟨i, hi⟩ : ∃ i : Fin 5, e i ≠ 0 := by
    by_contra h
    apply he0
    ext i
    exact not_not.mp (not_exists.mp h i)
  exact ⟨i, Set.mem_univ i, hi⟩

section CoefficientExtension

variable {R S : Type} [CommRing R] [CommRing S]

/-- Changing coefficients preserves the actual weighted degree. -/
def polynomialCoefficientMap (φ : R →+* S) : PolynomialGrade R →+*ᵍ PolynomialGrade S where
  toRingHom := MvPolynomial.map φ
  map_mem := by
    intro n p hp e he
    apply hp
    intro hz
    apply he
    simpa only [coeff_map, hz, map_zero]

theorem irrelevant_le_map_polynomialCoefficientMap (φ : R →+* S) :
    HomogeneousIdeal.irrelevant (PolynomialGrade S) ≤
      (HomogeneousIdeal.irrelevant (PolynomialGrade R)).map (polynomialCoefficientMap φ) := by
  apply HomogeneousIdeal.toIdeal_le_toIdeal_iff.mp
  apply (HomogeneousIdeal.toIdeal_irrelevant_le (PolynomialGrade S)).mpr
  intro n hn p hp
  have hvars : Ideal.span (Set.range (X : Fin 5 → MvPolynomial (Fin 5) S)) ≤
      ((HomogeneousIdeal.irrelevant (PolynomialGrade R)).map
        (polynomialCoefficientMap φ)).toIdeal := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    have hX := Ideal.mem_map_of_mem (polynomialCoefficientMap φ)
      (HomogeneousIdeal.mem_irrelevant_of_mem (PolynomialGrade R)
        (geometricWeight_pos i) (isWeightedHomogeneous_X R geometricWeight i))
    simpa only [polynomialCoefficientMap, map_X] using hX
  exact hvars (homogeneous_mem_variableIdeal hn hp)

/-- The actual weighted projective morphism induced by changing only
coefficients. All five geometric coordinates map to themselves. -/
def weightedAmbientCoefficientMap (φ : R →+* S) :
    weightedAmbient S ⟶ weightedAmbient R :=
  Proj.map (polynomialCoefficientMap φ) (irrelevant_le_map_polynomialCoefficientMap φ)

@[simp] theorem weightedAmbientCoefficientMap_preimage_basicOpen (φ : R →+* S)
    (p : MvPolynomial (Fin 5) R) :
    weightedAmbientCoefficientMap φ ⁻¹ᵁ Proj.basicOpen (PolynomialGrade R) p =
      Proj.basicOpen (PolynomialGrade S) (MvPolynomial.map φ p) :=
  Proj.map_preimage_basicOpen _ _ p

end CoefficientExtension

section SexticHypersurface

variable {S : Type} [CommRing S] [Algebra ℂ S]

def sexticIdeal (y : ParameterIndex → S) : Ideal (MvPolynomial (Fin 5) S) :=
  Ideal.span {pointEquationF y}

theorem sexticIdeal_homogeneous (y : ParameterIndex → S) :
    (sexticIdeal y).IsHomogeneous (PolynomialGrade S) := by
  apply Ideal.homogeneous_span
  intro p hp
  obtain rfl := Set.mem_singleton_iff.mp hp
  exact ⟨6, pointEquationF_homogeneous y⟩

abbrev SexticRing (y : ParameterIndex → S) :=
  MvPolynomial (Fin 5) S ⧸ sexticIdeal y

abbrev sexticGrade (y : ParameterIndex → S) (n : ℕ) : Submodule S (SexticRing y) :=
  CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.grade
    (PolynomialGrade S) (sexticIdeal y) n

instance sexticGradedRing (y : ParameterIndex → S) : GradedRing (sexticGrade y) :=
  CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.gradedRing
    (PolynomialGrade S) (sexticIdeal y) (sexticIdeal_homogeneous y)

/-- The literal weighted F=0 projective scheme. No dimension or
smoothness property is included in this definition. -/
def weightedThreefold (y : ParameterIndex → S) : Scheme := Proj (sexticGrade y)

def weightedThreefoldToBase (y : ParameterIndex → S) :
    weightedThreefold y ⟶ Spec (CommRingCat.of S) :=
  Proj.toSpecZero (sexticGrade y) ≫
    Spec.map (CommRingCat.ofHom (algebraMap S (sexticGrade y 0)))

def weightedThreefoldToAmbient (y : ParameterIndex → S) :
    weightedThreefold y ⟶ weightedAmbient S :=
  Proj.map
    (CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.quotientMap
      (PolynomialGrade S) (sexticIdeal y))
    (CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.irrelevant_le_map_quotientMap
      (PolynomialGrade S) (sexticIdeal y))

theorem sexticIdeal_le_pointEquations (y : ParameterIndex → S) :
    sexticIdeal y ≤ pointEquations y := by
  apply Ideal.span_le.mpr
  intro p hp
  obtain rfl := Set.mem_singleton_iff.mp hp
  exact Ideal.subset_span (by simp [pointEquations, equationsIdeal])

def surfaceThreefoldRingMap (y : ParameterIndex → S) : sexticGrade y →+*ᵍ surfaceGrade y where
  toRingHom := Ideal.Quotient.factor (sexticIdeal_le_pointEquations y)
  map_mem := by
    intro n q hq
    obtain ⟨p, hp, rfl⟩ := hq
    exact ⟨p, hp, rfl⟩

theorem irrelevant_le_map_surfaceThreefoldRingMap (y : ParameterIndex → S) :
    HomogeneousIdeal.irrelevant (surfaceGrade y) ≤
      (HomogeneousIdeal.irrelevant (sexticGrade y)).map (surfaceThreefoldRingMap y) := by
  apply HomogeneousIdeal.toIdeal_le_toIdeal_iff.mp
  apply (HomogeneousIdeal.toIdeal_irrelevant_le (surfaceGrade y)).mpr
  intro n hn q hq
  obtain ⟨p, hp, rfl⟩ := hq
  exact Ideal.mem_map_of_mem (surfaceThreefoldRingMap y)
    (HomogeneousIdeal.mem_irrelevant_of_mem (sexticGrade y) hn
      (show Ideal.Quotient.mk (sexticIdeal y) p ∈ sexticGrade y n from ⟨p, hp, rfl⟩))

/-- Actual containment of the cubic/sextic incidence surface in F=0. -/
def surfaceToThreefold (y : ParameterIndex → S) : surface y ⟶ weightedThreefold y :=
  Proj.map (surfaceThreefoldRingMap y) (irrelevant_le_map_surfaceThreefoldRingMap y)

theorem surfaceToThreefold_toAmbient (y : ParameterIndex → S) :
    surfaceToThreefold y ≫ weightedThreefoldToAmbient y = surfaceToAmbient y := by
  unfold surfaceToThreefold weightedThreefoldToAmbient surfaceToAmbient
  rw [← Proj.map_comp]
  have h : (surfaceThreefoldRingMap y).comp
      (CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.quotientMap
        (PolynomialGrade S) (sexticIdeal y)) =
      CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.quotientMap
        (PolynomialGrade S) (pointEquations y) := by
    ext p
    rfl
  rw [h]

theorem surfaceToThreefold_toBase (y : ParameterIndex → S) :
    surfaceToThreefold y ≫ weightedThreefoldToBase y = surfaceToBase y := by
  apply projectiveMap_coefficientBase (surfaceThreefoldRingMap y)
    (irrelevant_le_map_surfaceThreefoldRingMap y)
    (algebraMap S (sexticGrade y 0)) (surfaceCoefficient y)
  ext c
  apply Subtype.ext
  rfl

@[simp] theorem weightedThreefold_equation_zero (y : ParameterIndex → S) :
    Ideal.Quotient.mk (sexticIdeal y) (pointEquationF y) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))

end SexticHypersurface

section ForgetSectionParameters

variable {S : Type} [CommRing S] [Algebra ℂ S]

theorem pointEquations_le_section_kernel (y : ParameterIndex → S) :
    pointEquations y ≤ RingHom.ker
      ((Ideal.Quotient.mk (pointEquations (sectionPoint y))).comp
        (MvPolynomial.map (C : S →+* SectionBase S))) := by
  apply Ideal.span_le.mpr
  intro p hp
  simp only [pointEquations, equationsIdeal, Set.mem_insert_iff,
    Set.mem_singleton_iff] at hp
  rcases hp with rfl | rfl
  · change Ideal.Quotient.mk (pointEquations (sectionPoint y))
      (MvPolynomial.map (C : S →+* SectionBase S) (pointEquationH y)) = 0
    rw [← pointEquationH_sectionPoint]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (by simp [pointEquations, equationsIdeal]))
  · change Ideal.Quotient.mk (pointEquations (sectionPoint y))
      (MvPolynomial.map (C : S →+* SectionBase S) (pointEquationF y)) = 0
    rw [← pointEquationF_sectionPoint]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (by simp [pointEquations, equationsIdeal]))

/-- The actual scalar-extension map on the original surface coordinate
ring; it sends each geometric coordinate to the same coordinate. -/
def surfaceSectionRingMap (y : ParameterIndex → S) :
    surfaceGrade y →+*ᵍ surfaceGrade (sectionPoint y) where
  toRingHom := Ideal.Quotient.lift (pointEquations y)
    ((Ideal.Quotient.mk (pointEquations (sectionPoint y))).comp
      (MvPolynomial.map (C : S →+* SectionBase S)))
    (fun p hp => pointEquations_le_section_kernel y hp)
  map_mem := by
    intro n q hq
    obtain ⟨p, hp, rfl⟩ := hq
    exact ⟨MvPolynomial.map (C : S →+* SectionBase S) p,
      (polynomialCoefficientMap (C : S →+* SectionBase S)).map_mem hp, rfl⟩

@[simp] theorem surfaceSectionRingMap_polynomial (y : ParameterIndex → S)
    (p : MvPolynomial (Fin 5) S) :
    surfaceSectionRingMap y (Ideal.Quotient.mk (pointEquations y) p) =
      Ideal.Quotient.mk (pointEquations (sectionPoint y))
        (MvPolynomial.map (C : S →+* SectionBase S) p) := rfl

theorem irrelevant_le_map_surfaceSectionRingMap (y : ParameterIndex → S) :
    HomogeneousIdeal.irrelevant (surfaceGrade (sectionPoint y)) ≤
      (HomogeneousIdeal.irrelevant (surfaceGrade y)).map (surfaceSectionRingMap y) := by
  apply HomogeneousIdeal.toIdeal_le_toIdeal_iff.mp
  apply (HomogeneousIdeal.toIdeal_irrelevant_le (surfaceGrade (sectionPoint y))).mpr
  intro n hn q hq
  obtain ⟨p, hp, rfl⟩ := hq
  have hvars : Ideal.span (Set.range (X : Fin 5 → MvPolynomial (Fin 5) (SectionBase S))) ≤
      (((HomogeneousIdeal.irrelevant (surfaceGrade y)).map
        (surfaceSectionRingMap y)).toIdeal).comap
          (Ideal.Quotient.mk (pointEquations (sectionPoint y))) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change Ideal.Quotient.mk (pointEquations (sectionPoint y)) (X i) ∈ _
    have hX := Ideal.mem_map_of_mem (surfaceSectionRingMap y)
      (HomogeneousIdeal.mem_irrelevant_of_mem (surfaceGrade y) (geometricWeight_pos i)
        (show Ideal.Quotient.mk (pointEquations y) (X i) ∈
          surfaceGrade y (geometricWeight i) from
            ⟨X i, isWeightedHomogeneous_X S geometricWeight i, rfl⟩))
    simpa only [surfaceSectionRingMap_polynomial, map_X] using hX
  exact hvars (homogeneous_mem_variableIdeal hn hp)

/-- Forget the section parameters on the actual incidence surface. -/
def surfaceForgetSections (y : ParameterIndex → S) : surface (sectionPoint y) ⟶ surface y :=
  Proj.map (surfaceSectionRingMap y) (irrelevant_le_map_surfaceSectionRingMap y)

theorem surfaceForgetSections_toAmbient (y : ParameterIndex → S) :
    surfaceForgetSections y ≫ surfaceToAmbient y =
      surfaceToAmbient (sectionPoint y) ≫
        weightedAmbientCoefficientMap (C : S →+* SectionBase S) := by
  unfold surfaceForgetSections surfaceToAmbient weightedAmbientCoefficientMap
  rw [← Proj.map_comp, ← Proj.map_comp]
  have h : (surfaceSectionRingMap y).comp
      (CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.quotientMap
        (PolynomialGrade S) (pointEquations y)) =
      (CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.quotientMap
        (PolynomialGrade (SectionBase S)) (pointEquations (sectionPoint y))).comp
          (polynomialCoefficientMap (C : S →+* SectionBase S)) := by
    ext p
    rfl
  rw [h]

theorem surfaceForgetSections_toBase (y : ParameterIndex → S) :
    surfaceForgetSections y ≫ surfaceToBase y =
      surfaceToBase (sectionPoint y) ≫ Spec.map (CommRingCat.ofHom (C : S →+* SectionBase S)) := by
  have h := projectiveMap_coefficientBase (surfaceSectionRingMap y)
    (irrelevant_le_map_surfaceSectionRingMap y) (surfaceCoefficient y)
    ((surfaceCoefficient (sectionPoint y)).comp (C : S →+* SectionBase S)) (by
      ext c
      apply Subtype.ext
      change Ideal.Quotient.mk (pointEquations (sectionPoint y))
          (MvPolynomial.map (C : S →+* SectionBase S) (C c)) =
        Ideal.Quotient.mk (pointEquations (sectionPoint y)) (C (C c))
      rw [map_C])
  simpa only [surfaceForgetSections, surfaceToBase, Category.assoc, ← Spec.map_comp] using h

theorem genericCurveToSurface_toAmbient (y : ParameterIndex → S) :
    genericCurveToSurface y ≫ surfaceToAmbient (sectionPoint y) = genericCurveToAmbient y := by
  unfold genericCurveToSurface surfaceToAmbient genericCurveToAmbient
  rw [← Proj.map_comp]
  have h : (genericCurveSurfaceRingMap y).comp
      (CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.quotientMap
        (PolynomialGrade (SectionBase S)) (pointEquations (sectionPoint y))) =
      CycleQ2GeometricProjectiveCurve.HomogeneousQuotient.quotientMap
        (PolynomialGrade (SectionBase S)) (genericCurveIdeal y) := by
    ext p
    rfl
  rw [h]

theorem genericCurveToSurface_toBase (y : ParameterIndex → S) :
    genericCurveToSurface y ≫ surfaceToBase (sectionPoint y) = genericCurveToBase y := by
  apply projectiveMap_coefficientBase (genericCurveSurfaceRingMap y)
    (irrelevant_le_map_genericCurveSurfaceRingMap y)
    (surfaceCoefficient (sectionPoint y))
    (algebraMap (SectionBase S) (genericCurveGrade y 0))
  ext c
  apply Subtype.ext
  rfl

/-- The original projective family has an actual morphism to the same
weighted sextic hypersurface over S, without the section variables. -/
def genericCurveToThreefold (y : ParameterIndex → S) : genericCurve y ⟶ weightedThreefold y :=
  genericCurveToSurface y ≫ surfaceForgetSections y ≫ surfaceToThreefold y

theorem genericCurveToThreefold_toAmbient (y : ParameterIndex → S) :
    genericCurveToThreefold y ≫ weightedThreefoldToAmbient y =
      genericCurveToAmbient y ≫ weightedAmbientCoefficientMap (C : S →+* SectionBase S) := by
  simp only [genericCurveToThreefold, Category.assoc, surfaceToThreefold_toAmbient]
  rw [surfaceForgetSections_toAmbient, ← Category.assoc,
    genericCurveToSurface_toAmbient]

/-- The actual containment morphism lies over S, with the original
structure map from the full section-parameter base. -/
theorem genericCurveToThreefold_toBase (y : ParameterIndex → S) :
    genericCurveToThreefold y ≫ weightedThreefoldToBase y =
      genericCurveToBase y ≫ Spec.map (CommRingCat.ofHom (C : S →+* SectionBase S)) := by
  simp only [genericCurveToThreefold, Category.assoc, surfaceToThreefold_toBase]
  rw [surfaceForgetSections_toBase, ← Category.assoc, genericCurveToSurface_toBase]

@[simp] theorem genericCurve_cubic_zero (y : ParameterIndex → S) :
    Ideal.Quotient.mk (genericCurveIdeal y) (pointEquationH (sectionPoint y)) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr
    (le_sup_left (Ideal.subset_span (by simp [pointEquations, equationsIdeal])))

@[simp] theorem genericCurve_sextic_zero (y : ParameterIndex → S) :
    Ideal.Quotient.mk (genericCurveIdeal y) (pointEquationF (sectionPoint y)) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr
    (le_sup_left (Ideal.subset_span (by simp [pointEquations, equationsIdeal])))

/-- The defining equations vanish in the actual generic-curve ring,
with their original cubic, sextic and degree-fourteen section entries. -/
theorem genericCurve_defining_equations (y : ParameterIndex → S) :
    Ideal.Quotient.mk (genericCurveIdeal y) (pointEquationH (sectionPoint y)) = 0 ∧
    Ideal.Quotient.mk (genericCurveIdeal y) (pointEquationF (sectionPoint y)) = 0 ∧
    ∀ i : Fin 3, Ideal.Quotient.mk (genericCurveIdeal y) (genericSectionEquation y i) = 0 :=
  ⟨genericCurve_cubic_zero y, genericCurve_sextic_zero y, genericCurve_equation_zero y⟩

end ForgetSectionParameters

section TraceFamily

open Matrix CycleQ2IncidenceTraceFamily CycleQ2IncidenceTraceGeometry
  CycleQ2SegreFullJacobianBounds CycleQ2IncidenceCompatibleGenericPoint

/-- The original full invariant sextic with its actual independent
coefficient parameters. It contains no section parameters or solver variables. -/
def universalSextic : MvPolynomial (Fin 5) TraceRing :=
  fullInvariantPolynomial 6 sexticParameter

variable {S : Type} [CommRing S] [Algebra TraceRing S]
  [Algebra ℂ S] [IsScalarTower ℂ TraceRing S]

theorem tracePoint_equationF (B : Matrix FixedSexticParameters SquareIndex ℂ)
    (z : SquareIndex → S) :
    pointEquationF (tracePointValue B z) =
      MvPolynomial.map (algebraMap TraceRing S) universalSextic := by
  rw [pointEquationF, pointMap_familyF, universalSextic, map_fullInvariantPolynomial]
  congr 1
  funext j
  exact sextic_coordinate_fixed B z j

/-- The exact sextic of the candidate projective curve, before quotienting,
is still the same universal sextic after extending scalar coefficients. -/
theorem tracePoint_sectionEquationF (B : Matrix FixedSexticParameters SquareIndex ℂ)
    (z : SquareIndex → S) :
    pointEquationF (sectionPoint (tracePointValue B z)) =
      MvPolynomial.map ((C : S →+* SectionBase S).comp (algebraMap TraceRing S))
        universalSextic := by
  rw [pointEquationF_sectionPoint, tracePoint_equationF, map_map]

/-- The universal sextic vanishes on the original projective-family cone
through the actual coefficient map, not a newly substituted equation. -/
theorem tracePoint_universalSextic_zero (B : Matrix FixedSexticParameters SquareIndex ℂ)
    (z : SquareIndex → S) :
    Ideal.Quotient.mk (genericCurveIdeal (tracePointValue B z))
      (MvPolynomial.map ((C : S →+* SectionBase S).comp (algebraMap TraceRing S))
        universalSextic) = 0 := by
  rw [← tracePoint_sectionEquationF B z]
  exact genericCurve_sextic_zero (tracePointValue B z)

end TraceFamily

#print axioms genericCurveToThreefold_toAmbient
#print axioms genericCurveToThreefold_toBase
#print axioms genericCurve_defining_equations
#print axioms tracePoint_universalSextic_zero

end CycleQ2IncidenceFamilyContainment

