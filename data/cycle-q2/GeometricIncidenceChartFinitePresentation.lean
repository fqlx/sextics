import Proposal.GeometricIncidenceDehomogenizedChart
import Mathlib.RingTheory.FinitePresentation
import Mathlib.RingTheory.Localization.Away.AdjoinRoot

/-!
# Finite presentation of the actual relative incidence charts

Status: source-only proof draft. No elaboration or kernel replay was run.

The dehomogenized incidence chart is a quotient of a polynomial algebra
in four variables by the ideal generated by its two equations. This gives
finite presentation over every coefficient algebra S, without a
Noetherian hypothesis. Localizing any chart at one element preserves
finite presentation over S.

This component supplies only finite presentation. The geometric strategy
is due to Ben Diamond and the collaborators cited in solution.md.
Prepared for fqlx with OpenAI ChatGPT assistance.
-/

set_option autoImplicit false
set_option Elab.async false

noncomputable section

namespace CycleQ2IncidenceChartFinitePresentation

open CycleQ2IncidenceUniversalChart CycleQ2IncidenceDehomogenizedChart

variable {S : Type} [CommRing S] [Algebra ℂ S]

/-- The actual two-equation chart ideal is finitely generated over any base. -/
theorem chartIdeal_fg (v : Fin 2 → ChartPolynomial S) : (chartIdeal v).FG := by
  change (Submodule.span (ChartPolynomial S) (Set.range v)).FG
  exact Submodule.fg_span (Set.finite_range v)

/-- A four-variable polynomial algebra modulo the two chart equations is
finitely presented over its coefficient ring. -/
theorem chartRing_finitePresentation (v : Fin 2 → ChartPolynomial S) :
    Algebra.FinitePresentation S (ChartRing v) := by
  exact Algebra.FinitePresentation.quotient (R := S) (chartIdeal_fg v)

/-- Finite presentation of each actual shifted dehomogenized incidence chart. -/
theorem dehomogenizedRing_finitePresentation (y : ParameterIndex → S) (i : Fin 4) :
    Algebra.FinitePresentation S (DehomogenizedRing y i) :=
  chartRing_finitePresentation (dehomogenizedEquations y i)

/-- Every principal open of an actual incidence chart is finitely presented
over the same coefficient ring. -/
theorem dehomogenizedAway_finitePresentation (y : ParameterIndex → S) (i : Fin 4)
    (a : DehomogenizedRing y i) :
    Algebra.FinitePresentation S (Localization.Away a) := by
  letI : Algebra.FinitePresentation S (DehomogenizedRing y i) :=
    dehomogenizedRing_finitePresentation y i
  exact Algebra.FinitePresentation.of_isLocalizationAway a

end CycleQ2IncidenceChartFinitePresentation

end
