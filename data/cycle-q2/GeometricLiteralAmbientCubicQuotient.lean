private abbrev G := sexticGrade point
private abbrev A := SexticRing point
private abbrev q := Ideal.Quotient.mk (sexticIdeal point)
private abbrev x (i : Fin 4) := sexticX point i

def cubic : A := q (pointEquationH point)

private theorem surfaceIdeal_eq :
    surfaceIdeal 57 1 = Ideal.span {pointEquationF point, pointEquationH point} := by
  change Ideal.span (Set.range (surfaceEquations 57 1)) = _
  congr 1
  rw [CycleQ2IncidenceChartSeedFiber.literal_pointEquationF,
    CycleQ2IncidenceChartSeedFiber.literal_pointEquationH,
    ← actualSeedEquation_eq_smoothF, smoothH_eq_thetaH]
  ext p
  constructor
  · rintro ⟨j,rfl⟩
    fin_cases j <;> simp [surfaceEquations]
  · rintro (rfl | hp)
    · exact ⟨0, rfl⟩
    · exact ⟨1, (Set.mem_singleton_iff.mp hp).symm⟩

theorem cone_kernel : RingHom.ker toTraceGraded.toRingHom = Ideal.span {cubic} := by
  have hc : (RingHom.ker toTraceGraded.toRingHom).comap q = surfaceIdeal 57 1 := by
    ext b
    change Ideal.Quotient.mk (surfaceIdeal 57 1) b = 0 ↔ b ∈ surfaceIdeal 57 1
    exact Ideal.Quotient.eq_zero_iff_mem
  rw [← Ideal.map_comap_of_surjective q Ideal.Quotient.mk_surjective
    (RingHom.ker toTraceGraded.toRingHom), hc,
    surfaceIdeal_eq, Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  have hz : q (pointEquationF point) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (Set.mem_singleton _))
  change Ideal.span {q (pointEquationF point), cubic} = _
  rw [hz, Ideal.span_insert_zero]

/-- Contraction of the kernel of a graded quotient from the ordinary localization. -/
private theorem away_kernel_comap {R S σ τ : Type} [CommRing R] [CommRing S]
    [SetLike σ R] [SetLike τ S] [AddSubgroupClass σ R] [AddSubgroupClass τ S]
    (𝒜 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
    (s : R) {d : ℕ} (hs : s ∈ 𝒜 d) :
    RingHom.ker (Away.map f s) =
      ((RingHom.ker f.toRingHom).map (algebraMap R (Localization.Away s))).comap
        (algebraMap (Away 𝒜 s) (Localization.Away s)) := by
  ext z
  obtain ⟨n, p, hp, rfl⟩ := Away.mk_surjective 𝒜 hs z
  change Away.map f s (Away.mk 𝒜 hs n p hp) = 0 ↔
    (Away.mk 𝒜 hs n p hp).val ∈ (RingHom.ker f.toRingHom).map _
  rw [Away.map_mk, HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.val_zero,
    Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff,
    Away.val_mk, Localization.mk_eq_mk', IsLocalization.mk'_mem_map_algebraMap_iff]
  constructor
  · rintro ⟨⟨_, k, rfl⟩, hk⟩
    refine ⟨s ^ k, ⟨k,rfl⟩, ?_⟩
    change f (s ^ k * p) = 0
    simpa only [map_mul, map_pow] using hk
  · rintro ⟨_, ⟨k,rfl⟩, hk⟩
    refine ⟨⟨(f s)^k, ⟨k,rfl⟩⟩, ?_⟩
    change f (s ^ k * p) = 0 at hk
    simpa only [map_mul, map_pow] using hk

def chartFraction (i : Fin 4) : SexticChart point i :=
  sexticFraction point i 3 (pointEquationH point) (pointEquationH_homogeneous point)

theorem chart_kernel (i : Fin 4) :
    RingHom.ker (Away.map toTraceGraded (x i)) = Ideal.span {chartFraction i} := by
  rw [away_kernel_comap _ _ _ _ (sexticX_mem point i), cone_kernel, Ideal.map_span,
    Set.image_singleton]
  have he : (chartFraction i).val * algebraMap A (Localization.Away (x i)) (x i ^ 3) =
      algebraMap A (Localization.Away (x i)) cubic := by
    rw [chartFraction, sexticFraction, Away.val_mk, Localization.mk_eq_mk']
    exact IsLocalization.mk'_spec _ _ _
  have hu : IsUnit (algebraMap A (Localization.Away (x i)) (x i ^ 3)) := by
    rw [map_pow]
    exact (IsLocalization.Away.algebraMap_isUnit (x i)).pow 3
  rw [← he, Ideal.span_singleton_mul_right_unit hu]
  exact CycleQ2GradedLocalizationProjection.principalIdeal_comap_val G
    (sexticX_mem point i) (chartFraction i)

def nativeOpen (i : Fin 4) : Native.Opens := Proj.basicOpen G (x i)

def nativeSection (i : Fin 4) : Γ(Native, nativeOpen i) :=
  Proj.awayToSection G (x i) (chartFraction i)

theorem native_chart_kernel (i : Fin 4) :
    RingHom.ker (surfaceToNative.app (nativeOpen i)).hom = Ideal.span {nativeSection i} := by
  calc
    _ = (RingHom.ker (Away.map toTraceGraded (x i))).map
        (CycleQ2GeometricLiteralSurface.projChartSectionsEquiv G (x i) (sexticX_mem point i)
          (by decide)).toRingHom :=
      CycleQ2GeometricLiteralSurface.projMap_chart_ker_eq_map G _ toTraceGraded trace_irrelevant
        (x i) (sexticX_mem point i) (by decide)
    _ = _ := by
      rw [chart_kernel, Ideal.map_span, Set.image_singleton]
      rfl

private theorem surfaceToNative_closed : IsClosedImmersion surfaceToNative := by
  have : IsClosedImmersion surfaceToFiber := surfaceToFiber_isClosedImmersion
  rw [show surfaceToNative = surfaceToFiber ≫ nativeToIncidence.inv by
    rw [← surfaceToNative_toIncidence]; simp]
  infer_instance

private theorem restrict_kernel {D X : Scheme} (f : D ⟶ X) [QuasiCompact f]
    {U : X.Opens} (hU : IsAffineOpen U) (s : Γ(X,U))
    (hs : RingHom.ker (f.app U).hom = Ideal.span {s}) (V : X.affineOpens) (h : V.1 ≤ U) :
    RingHom.ker (f.app V.1).hom = Ideal.span {X.presheaf.map (homOfLE h).op s} := by
  have he := f.ker.map_ideal (U := V) (V := ⟨U,hU⟩) h
  rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply] at he
  rw [← he, hs, Ideal.map_span, Set.image_singleton]
  rfl

private theorem transported_kernel {D X Y : Scheme} (f : D ⟶ X) (e : X ≅ Y)
    (U : X.Opens) (s : Γ(X,U)) (hs : RingHom.ker (f.app U).hom = Ideal.span {s}) :
    RingHom.ker ((f ≫ e.hom).app (e.inv ⁻¹ᵁ U)).hom = Ideal.span {e.inv.app U s} := by
  let a := e.inv.app U
  have hcomp : (f ≫ e.hom) ≫ e.inv = f := by simp
  have h := congrArg (fun m => RingHom.ker (Scheme.Hom.app m U).hom) hcomp
  change RingHom.ker (((f ≫ e.hom) ≫ e.inv).app U).hom = _ at h
  rw [Scheme.Hom.comp_app, CommRingCat.hom_comp, ← RingHom.comap_ker, hs] at h
  change (RingHom.ker ((f ≫ e.hom).app (e.inv ⁻¹ᵁ U)).hom).comap a.hom = Ideal.span {s} at h
  rw [← Ideal.map_comap_of_surjective a.hom (ConcreteCategory.bijective_of_isIso a).surjective
    (RingHom.ker ((f ≫ e.hom).app (e.inv ⁻¹ᵁ U)).hom), h, Ideal.map_span, Set.image_singleton]

theorem native_kernel_on_affine (i : Fin 4) (V : Native.affineOpens)
    (h : V.1 ≤ nativeOpen i) :
    RingHom.ker (surfaceToNative.app V.1).hom =
      Ideal.span {Native.presheaf.map (homOfLE h).op (nativeSection i)} := by
  let := surfaceToNative_closed
  exact restrict_kernel surfaceToNative
    (Proj.isAffineOpen_basicOpen G (x i) (sexticX_mem point i) (by decide))
    (nativeSection i) (native_chart_kernel i) V h

def incidenceOpen (i : Fin 4) : (IncidenceFiber 57).Opens :=
  nativeToIncidence.inv ⁻¹ᵁ nativeOpen i

def incidenceSection (i : Fin 4) : Γ(IncidenceFiber 57, incidenceOpen i) :=
  nativeToIncidence.inv.app (nativeOpen i) (nativeSection i)

/-- On every affine subopen of this chart the actual restriction to the trace
surface is surjective and its kernel consists of multiples of the cubic. -/
theorem incidence_quotient_on_affine (i : Fin 4) (V : (IncidenceFiber 57).affineOpens)
    (h : V.1 ≤ incidenceOpen i) :
    Function.Surjective (surfaceToFiber.app V.1) ∧
      RingHom.ker (surfaceToFiber.app V.1).hom =
        Ideal.span {(IncidenceFiber 57).presheaf.map (homOfLE h).op (incidenceSection i)} := by
  let := surfaceToFiber_isClosedImmersion
  refine ⟨surfaceToFiber.app_surjective V.1 V.2, restrict_kernel surfaceToFiber
    ((Proj.isAffineOpen_basicOpen G (x i) (sexticX_mem point i) (by decide)).preimage
      nativeToIncidence.inv) (incidenceSection i) ?_ V h⟩
  rw [← surfaceToNative_toIncidence]
  exact transported_kernel surfaceToNative nativeToIncidence _ _ (native_chart_kernel i)

private theorem transported_kernel_on_affine {D X Y : Scheme} (f : D ⟶ X)
    [IsClosedImmersion f] (e : X ≅ Y) (U : X.Opens) (hU : IsAffineOpen U) (s : Γ(X,U))
    (hs : RingHom.ker (f.app U).hom = Ideal.span {s}) (V : Y.affineOpens)
    (h : V.1 ≤ e.inv ⁻¹ᵁ U) :
    RingHom.ker ((f ≫ e.hom).app V.1).hom = Ideal.span {(e.inv.appLE U V.1 h).hom s} := by
  exact restrict_kernel (f ≫ e.hom) (hU.preimage e.inv) (e.inv.app U s)
    (transported_kernel f e U s hs) V h

open CycleQ2GeometricHodgeThreefold
open CycleQ2GeometricHodgeThreefoldIncidence (nativeIso nativeIso_preimage
  nativeIso_normalized)

private abbrev eval := CycleQ2GeometricHodgeThreefoldIncidence.sexticEval point
abbrev model := threefold eval
abbrev surfaceToModel := surfaceToNative ≫ (nativeIso point).inv

set_option maxRecDepth 5000 in
set_option maxHeartbeats 1800000 in
/-- The ideal on the full-coefficient model of the literal incidence fiber,
in the same coordinates used by the twisting sheaf. -/
theorem model_kernel_on_affine (i : Fin 4) (V : model.affineOpens)
    (h : V.1 ≤ coordinateOpen eval i) :
    RingHom.ker (surfaceToModel.app V.1).hom =
      Ideal.span {CycleQ2HodgeTwistRatios.normalized eval i (n := 3)
        (quotient eval (pointEquationH point))
        (quotient_mem_grade eval (n := 3) (pointEquationH point) (pointEquationH_homogeneous point)) V.1 h} := by
  let := surfaceToNative_closed
  have h' : V.1 ≤ (nativeIso point).hom ⁻¹ᵁ nativeOpen i :=
    h.trans (nativeIso_preimage point i).ge
  refine (transported_kernel_on_affine surfaceToNative (nativeIso point).symm (nativeOpen i)
    (Proj.isAffineOpen_basicOpen G (x i) (sexticX_mem point i) (by decide)) (nativeSection i)
    (native_chart_kernel i) V h').trans ?_
  have he := nativeIso_normalized point i 3 (pointEquationH point)
    (pointEquationH_homogeneous point) V.1 h
  exact congrArg (fun s : Γ(model,V.1) => Ideal.span {s}) he

end CycleQ2LiteralAmbientCubicQuotient
