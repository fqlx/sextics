import Proposal.GeometricLiteralMovingDivisorOrbitFrames
import Proposal.GeometricIntrinsicNormal
import Proposal.GeometricModuleLocalIso

/-!
# The pivot generates the actual kernel sheaf on an affine patch

When the kernel on a framed affine open is generated by the orbit pivot,
regularity of that pivot makes its coefficients unique on every subopen.
Affine restriction supplies the coefficients locally, and the structure
sheaf glues them to a natural linear frame for the kernel ideal.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section

namespace CycleQ2LiteralMovingPoleComponents

open CategoryTheory Opposite AlgebraicGeometry TopologicalSpace CycleQ2SeedProjectiveImageCocycle
  CycleQ2SeedSectionDivisorTransitions CycleQ2SeedSectionSheafGlobal
  CycleQ2LiteralMovingDivisorOrbitFrames CycleQ2GeometricIntrinsicNormal
  CycleQ2GeometricDifferentialSheaf CycleQ2GeometricModuleLocalIso

variable {X : Scheme.{0}} (j : X ⟶ Surface) [IsClosedImmersion j]
variable {U W : Surface.Opens} (f : FrameData U)

omit [IsClosedImmersion j] in
private theorem ker_res {V T : Surface.Opens} (h : T ≤ V) (r : Γ(Surface,V))
    (hr : r ∈ RingHom.ker (j.app V).hom) : targetRes h r ∈ RingHom.ker (j.app T).hom := by
  change j.app T (targetRes h r) = 0
  have he := ConcreteCategory.congr_hom (C := CommRingCat) (j.naturality (homOfLE h).op) r
  change j.app T (targetRes h r) = X.presheaf.map _ (j.app V r) at he
  have hr0 : j.app V r = 0 := hr
  rw [he, hr0, map_zero]

private theorem affine_kernel (hU : IsAffineOpen U)
    (hK : RingHom.ker (j.app U).hom = Ideal.span {pivotEquation f})
    (h : W ≤ U) (hW : IsAffineOpen W) :
    RingHom.ker (j.app W).hom = Ideal.span {targetRes h (pivotEquation f)} := by
  have he := j.ker.map_ideal (U := ⟨W,hW⟩) (V := ⟨U,hU⟩) h
  rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply] at he
  change (RingHom.ker (j.app U).hom).map (targetRes h) = RingHom.ker (j.app W).hom at he
  rw [← he, hK, Ideal.map_span, Set.image_singleton]

private abbrev affineIn (O : Surface.Opens) := {A : Surface.affineOpens // A.val ≤ O}
private abbrev openIn (O : Surface.Opens) (a : affineIn O) : Surface.Opens := a.val.val

private theorem covering (O : Surface.Opens) : O ≤ ⨆ a, openIn O a := by
  intro x hx
  obtain ⟨T,hT,hxT,hTO⟩ := Opens.isBasis_iff_nbhd.mp Surface.isBasis_affineOpens hx
  exact Opens.mem_iSup.mpr ⟨⟨⟨T,hT⟩,hTO⟩,hxT⟩

private theorem restrict_regular (h : W ≤ U) :
    Function.Injective (fun r : Γ(Surface,W) => r * targetRes h (pivotEquation f)) := by
  rw [pivotEquation_restrict]
  exact pivotEquation_regular _

private theorem coefficient_exists (hU : IsAffineOpen U)
    (hK : RingHom.ker (j.app U).hom = Ideal.span {pivotEquation f})
    (h : W ≤ U) (y : RingHom.ker (j.app W).hom) :
    ∃ r : Γ(Surface,W), r * targetRes h (pivotEquation f) = y.val := by
  have ha (a : affineIn W) : ∃ r : Γ(Surface,openIn W a),
      r * targetRes (a.property.trans h) (pivotEquation f) = targetRes a.property y.val := by
    have hy := ker_res j a.property y.val y.property
    rw [affine_kernel j f hU hK (a.property.trans h) a.val.property, Ideal.mem_span_singleton] at hy
    obtain ⟨r,hr⟩ := hy
    exact ⟨r, (mul_comm _ _).trans hr.symm⟩
  choose s hs using ha
  have hr (a : affineIn W) {T : Surface.Opens} (k : T ≤ openIn W a) :
      targetRes k (s a) * targetRes (k.trans (a.property.trans h)) (pivotEquation f) =
        targetRes (k.trans a.property) y.val := by
    simpa only [map_mul, targetRes_comp] using congrArg (targetRes k) (hs a)
  have hc : TopCat.Presheaf.IsCompatible Surface.sheaf.obj (openIn W) s := by
    intro a b
    apply restrict_regular f ((show openIn W a ⊓ openIn W b ≤ openIn W a from inf_le_left).trans
      (a.property.trans h))
    exact (hr a inf_le_left).trans (hr b inf_le_right).symm
  obtain ⟨r,hr',_⟩ := Surface.sheaf.existsUnique_gluing' (openIn W) W (fun a => homOfLE a.property)
    (covering W) s hc
  let rr : Γ(Surface,W) := r
  have hrr (a : affineIn W) : targetRes a.property rr = s a := hr' a
  refine ⟨rr, ?_⟩
  apply Surface.sheaf.eq_of_locally_eq' (openIn W) W (fun a => homOfLE a.property) (covering W)
  intro a
  change targetRes a.property (rr * targetRes h (pivotEquation f)) = _
  rw [map_mul, targetRes_comp]
  rw [hrr a]
  exact hs a

private def pivotSection (hK : RingHom.ker (j.app U).hom = Ideal.span {pivotEquation f})
    (h : W ≤ U) : RingHom.ker (j.app W).hom := ⟨targetRes h (pivotEquation f), ker_res j h _ (by
      rw [hK]
      exact Ideal.subset_span (Set.mem_singleton _))⟩

local instance (V : Surface.Opens) : Module Γ(Surface,V) ((kernelIdealSheaf j).val.obj (op V)) :=
  ((kernelIdealSheaf j).val.obj (op V)).isModule

/-- The restricted pivot is a basis of the actual sheaf kernel on every subopen. -/
def pivotKernelFrame (hU : IsAffineOpen U)
    (hK : RingHom.ker (j.app U).hom = Ideal.span {pivotEquation f}) (h : W ≤ U) :
    Γ(Surface,W) ≃ₗ[Γ(Surface,W)] (kernelIdealSheaf j).val.obj (op W) :=
  (LinearEquiv.ofBijective (LinearMap.toSpanSingleton (Γ(Surface,W)) _ (pivotSection j f hK h))
    ⟨fun _ _ he => restrict_regular f h (congrArg Subtype.val he), fun y => by
      obtain ⟨r,hr⟩ := coefficient_exists j f hU hK h y
      exact ⟨r,Subtype.ext hr⟩⟩).trans (kernelIdealSectionEquiv j W).symm

theorem pivotKernelFrame_coordinate (hU : IsAffineOpen U)
    (hK : RingHom.ker (j.app U).hom = Ideal.span {pivotEquation f})
    (h : W ≤ U) (r : Γ(Surface,W)) :
    (kernelIdealSectionEquiv j W (pivotKernelFrame j f hU hK h r) : Γ(Surface,W)) =
      r * targetRes h (pivotEquation f) := by
  change ((kernelIdealSectionEquiv j W) ((kernelIdealSectionEquiv j W).symm
    (r • pivotSection j f hK h)) : Γ(Surface,W)) = _
  rw [LinearEquiv.apply_symm_apply]
  rfl

/-- The local equivalences commute with every structure and ideal restriction. -/
def pivotKernelPatchIso (hU : IsAffineOpen U)
    (hK : RingHom.ker (j.app U).hom = Ideal.span {pivotEquation f}) :
    PatchIso (SheafOfModules.unit (ringSheaf Surface.sheaf)) (kernelIdealSheaf j) U where
  app W h := pivotKernelFrame j f hU hK h
  naturality {W V} k h r := by
    apply (kernelIdealSectionEquiv j V).injective
    apply Subtype.ext
    rw [kernelIdealSectionEquiv_restrict]
    let rr : Γ(Surface,W) := r
    change targetRes k (kernelIdealSectionEquiv j W (pivotKernelFrame j f hU hK h rr) : Γ(Surface,W)) =
      (kernelIdealSectionEquiv j V (pivotKernelFrame j f hU hK (k.trans h) (targetRes k rr)) : Γ(Surface,V))
    rw [pivotKernelFrame_coordinate, pivotKernelFrame_coordinate, map_mul, targetRes_comp]

end CycleQ2LiteralMovingPoleComponents
end

#print axioms CycleQ2LiteralMovingPoleComponents.pivotKernelPatchIso
