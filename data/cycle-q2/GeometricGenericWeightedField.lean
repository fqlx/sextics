import Proposal.GeometricGenericWeightedChainRule
import Proposal.GeometricGenericWeightedSource
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# The differential field of the weighted deformed chart

The two parameters and the four weighted affine coordinates generate an
intermediate field of the deformed function field. The implicit equation of
the chart keeps its three relative coordinate derivations inside this
intermediate field. Its cubic-pole density also belongs to that field.

Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false

noncomputable section

namespace CycleQ2GenericWeightedField

open MvPolynomial CycleQ2Bridge CycleQ2IncidenceNormalForm CycleQ2GenericPencilLift
  CycleQ2GenericSpecialization CycleQ2GenericWeightedCoordinates
  CycleQ2GenericWeightedPencilEquation CycleQ2GenericWeightedSource
open CycleQ2AffineWeightedTransfer (weightedSource)
open scoped BigOperators

/-- Rational functions generated by the deformation parameter, the pencil ratio and
the four affine weighted coordinates inside the actual generic function field. -/
def field (d : Direction) : IntermediateField ℂ RF :=
  IntermediateField.adjoin ℂ (insert (parameter d) (insert lambda (Set.range weightedPoint)))

theorem parameter_mem (d : Direction) : parameter d ∈ field d :=
  IntermediateField.subset_adjoin _ _ (Set.mem_insert _ _)

theorem lambda_mem (d : Direction) : lambda ∈ field d :=
  IntermediateField.subset_adjoin _ _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

theorem coordinate_mem (d : Direction) (i : Fin 5) : weightedPoint i ∈ field d :=
  IntermediateField.subset_adjoin _ _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩))

/-- The relative weight-one coordinates and the square coordinate, as elements of the field. -/
def coordinate (d : Direction) (j : Fin 3) : field d :=
  ⟨relativeCoordinate j, by
    fin_cases j
    · exact coordinate_mem d 2
    · exact coordinate_mem d 3
    · exact coordinate_mem d 4⟩

@[simp] theorem coordinate_coe (d : Direction) (j : Fin 3) :
    (coordinate d j : RF) = relativeCoordinate j := rfl

private abbrev FromField (d : Direction) (p : P) :=
  ∃ q : MvPolynomial (Fin 5) (field d), MvPolynomial.map (algebraMap (field d) RF) q = p

private theorem eval_mem_of_fromField (d : Direction) (p : P) (h : FromField d p) :
    eval weightedPoint p ∈ field d := by
  obtain ⟨q, rfl⟩ := h
  induction q using MvPolynomial.induction_on with
  | C a => simpa only [MvPolynomial.map_C, eval_C, IntermediateField.algebraMap_apply] using a.property
  | add p q hp hq => simpa only [map_add] using add_mem hp hq
  | mul_X p i hp => simpa only [map_mul, MvPolynomial.map_X, eval_X] using mul_mem hp (coordinate_mem d i)

private theorem pderiv_fromField (d : Direction) (p : P) (hp : FromField d p) (i : Fin 5) :
    FromField d (pderiv i p) := by
  obtain ⟨q, rfl⟩ := hp
  exact ⟨pderiv i q, pderiv_map.symm⟩

private theorem equation_lift {R : Type} [Field R] [Algebra ℂ R] (f : R →ₐ[ℂ] RF)
    (t l : R) (h : WeightedPoly) :
    ∃ q : MvPolynomial (Fin 5) R,
      MvPolynomial.map (f : R →+* RF) q = equation (f t) (f l) h := by
  refine ⟨X 0 ^ 6 + X 1 ^ 6 + X 2 ^ 6 + X 3 ^ 6 + C (1 + l ^ 6) * X 4 ^ 3 +
    C (1 / 2 : R) * (X 0 ^ 3 * X 1 * X 2 * X 3 +
      C l * X 1 ^ 3 * X 3 * X 4 + C l * X 0 * X 2 * X 4 ^ 2) +
    C t * MvPolynomial.map (algebraMap ℂ R) h, ?_⟩
  have hcoeff : MvPolynomial.map (f : R →+* RF) (MvPolynomial.map (algebraMap ℂ R) h) =
      MvPolynomial.map (algebraMap ℂ RF) h := by
    ext i
    simpa only [MvPolynomial.coeff_map, AlgHom.coe_toRingHom] using f.commutes (coeff i h)
  simp only [equation, map_add, map_mul, map_pow, MvPolynomial.map_C, MvPolynomial.map_X,
    map_one, map_div₀, map_ofNat, hcoeff, AlgHom.coe_toRingHom]

private theorem equation_fromField (d : Direction) (h : WeightedPoly) :
    FromField d (equation (parameter d) lambda h) :=
  equation_lift (IsScalarTower.toAlgHom ℂ (field d) RF)
    ⟨parameter d, parameter_mem d⟩ ⟨lambda, lambda_mem d⟩ h

variable (c : FullInvariantIndex 6 → ℂ) (hc : endpointDifference c ≠ 0)

private abbrev d := endpointDirection c hc

theorem normalJet_mem (n : ℕ) : familyNormalJet (d c hc) n ∈ field (d c hc) := by
  rw [← endpoint_normalJet c hc n]
  apply eval_mem_of_fromField
  generalize n + 1 = m
  induction m with
  | zero => exact equation_fromField _ _
  | succ m ih =>
    rw [Function.iterate_succ_apply']
    exact pderiv_fromField _ _ ih 1

private theorem deriv_coordinate_mem (j : Fin 3) (i : Fin 5) :
    relativeDerivation (d c hc) j (weightedPoint i) ∈ field (d c hc) := by
  have hfree (k : Fin 3) : relativeDerivation (d c hc) j (relativeCoordinate k) ∈ field (d c hc) := by
    rw [relativeDerivation_coordinate]
    split <;> simp
  fin_cases i
  · change relativeDerivation _ _ 1 ∈ _
    rw [Derivation.map_one_eq_zero]
    exact zero_mem _
  · change relativeDerivation _ _ (z 0) ∈ _
    rw [CycleQ2GenericWeightedChainRule.normal_coordinate c hc j]
    exact div_mem (neg_mem (eval_mem_of_fromField _ _ (pderiv_fromField _ _ (equation_fromField _ _) _)))
      (eval_mem_of_fromField _ _ (pderiv_fromField _ _ (equation_fromField _ _) _))
  · exact hfree 0
  · exact hfree 1
  · exact hfree 2

theorem deriv_mem (j : Fin 3) (x : RF) (hx : x ∈ field (d c hc)) :
    relativeDerivation (d c hc) j x ∈ field (d c hc) := by
  let D := relativeDerivation (d c hc) j
  change D x ∈ field (d c hc)
  refine IntermediateField.adjoin_induction ℂ (p := fun y _ => D y ∈ field (d c hc))
    ?_ ?_ ?_ ?_ ?_ hx
  · rintro x (rfl | rfl | ⟨i, rfl⟩)
    · change relativeDerivation _ _ (parameter _) ∈ _
      rw [relative_tau]
      exact zero_mem _
    · change relativeDerivation _ _ lambda ∈ _
      rw [relative_lambda]
      exact zero_mem _
    · exact deriv_coordinate_mem c hc j i
  · intro a
    rw [D.map_algebraMap]
    exact zero_mem _
  · intro x y _ _ hx hy
    rw [map_add]
    exact add_mem hx hy
  · intro x hx hDx
    rw [Derivation.leibniz_inv, smul_eq_mul]
    exact mul_mem (neg_mem (pow_mem (inv_mem hx) _)) hDx
  · intro x y hx hy hDx hDy
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact add_mem (mul_mem hx hDy) (mul_mem hy hDx)

/-- The relative derivation on the weighted rational function field itself. -/
def deriv (j : Fin 3) : Derivation ℂ (field (d c hc)) (field (d c hc)) where
  toFun x := ⟨relativeDerivation (d c hc) j (x : RF), deriv_mem c hc j x x.property⟩
  map_add' x y := Subtype.ext ((relativeDerivation (d c hc) j).map_add (x : RF) (y : RF))
  map_smul' a x := Subtype.ext ((relativeDerivation (d c hc) j).map_smul a (x : RF))
  map_one_eq_zero' := Subtype.ext (relativeDerivation (d c hc) j).map_one_eq_zero
  leibniz' x y := Subtype.ext ((relativeDerivation (d c hc) j).leibniz (x : RF) (y : RF))

@[simp] theorem deriv_coe (j : Fin 3) (x : field (d c hc)) :
    (deriv c hc j x : RF) = relativeDerivation (d c hc) j (x : RF) := rfl

/-- Rational functions in the two fixed parameters, taken inside the weighted field. -/
def parameterField (d : Direction) : IntermediateField ℂ (field d) :=
  IntermediateField.adjoin ℂ {⟨parameter d, parameter_mem d⟩, ⟨lambda, lambda_mem d⟩}

/-- The actual deformed equation has coefficients in the two-parameter field. -/
theorem equation_from_parameterField (d : Direction) (h : WeightedPoly) :
    ∃ p : MvPolynomial (Fin 5) (parameterField d),
      MvPolynomial.map ((algebraMap (field d) RF).comp (algebraMap (parameterField d) (field d))) p =
        equation (parameter d) lambda h := by
  let t : parameterField d := ⟨⟨parameter d, parameter_mem d⟩,
    IntermediateField.subset_adjoin _ _ (Set.mem_insert _ _)⟩
  let l : parameterField d := ⟨⟨lambda, lambda_mem d⟩,
    IntermediateField.subset_adjoin _ _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  exact equation_lift
    ((IsScalarTower.toAlgHom ℂ (field d) RF).comp (IsScalarTower.toAlgHom ℂ (parameterField d) (field d)))
    t l h

theorem deriv_parameterField (j : Fin 3) (b : parameterField (d c hc)) :
    deriv c hc j (b : field (d c hc)) = 0 :=
  CycleQ2GenericWeightedChainRule.adjoin_parameters_constant (deriv c hc j)
    ⟨parameter (d c hc), parameter_mem _⟩ ⟨lambda, lambda_mem _⟩
    (Subtype.ext (relative_tau (d c hc) j)) (Subtype.ext (relative_lambda (d c hc) j)) b

/-- The three derivations are linear over the field of both fixed parameters. -/
def parameterDeriv (j : Fin 3) :
    Derivation (parameterField (d c hc)) (field (d c hc)) (field (d c hc)) where
  toFun := deriv c hc j
  map_add' := (deriv c hc j).map_add
  map_smul' b x := by
    have hb : deriv c hc j (algebraMap (parameterField (d c hc)) (field (d c hc)) b) = 0 :=
      deriv_parameterField c hc j b
    simp only [Algebra.smul_def, Derivation.leibniz, hb, mul_zero, add_zero,
      Algebra.algebraMap_self, RingHom.id_apply]
  map_one_eq_zero' := (deriv c hc j).map_one_eq_zero
  leibniz' := (deriv c hc j).leibniz

@[simp] theorem parameterDeriv_apply (j : Fin 3) (x : field (d c hc)) :
    parameterDeriv c hc j x = deriv c hc j x := rfl

@[simp] theorem parameterDeriv_coordinate (i j : Fin 3) :
    parameterDeriv c hc i (coordinate (d c hc) j) = if i = j then 1 else 0 := by
  apply Subtype.ext
  change relativeDerivation (d c hc) i (relativeCoordinate j) = _
  rw [relativeDerivation_coordinate]
  split <;> rfl

theorem parameterDerivs_commute (i j : Fin 3) :
    Function.Commute (parameterDeriv c hc i) (parameterDeriv c hc j) :=
  fun x => Subtype.ext (relativeDerivations_commute (d c hc) i j (x : RF))

theorem density_mem : genericDensity (d c hc) weightedSource ∈ field (d c hc) := by
  have h₀ : z 0 ∈ field (d c hc) := coordinate_mem _ 1
  have h₂ : z 2 ∈ field (d c hc) := coordinate_mem _ 2
  have h₃ : z 3 ∈ field (d c hc) := coordinate_mem _ 3
  have hw : u ^ 2 ∈ field (d c hc) := coordinate_mem _ 4
  rw [genericDensity, weightedSource_value, weightedSource_firstJet_value,
    weightedSource_secondJet_value, SplitHigherResidue.normalSourceTwo]
  repeat' first
    | assumption
    | exact normalJet_mem c hc _
    | exact ofNat_mem _ _
    | exact one_mem _
    | apply add_mem
    | apply sub_mem
    | apply neg_mem
    | apply div_mem
    | apply mul_mem

/-- The relative cubic-pole density with values in the weighted function field. -/
def density : field (d c hc) :=
  ⟨genericDensity (d c hc) weightedSource, density_mem c hc⟩

@[simp] theorem density_coe : (density c hc : RF) = genericDensity (d c hc) weightedSource := rfl

theorem divergence_to_ambient (v : Fin 3 → field (d c hc))
    (hv : ∑ j, deriv c hc j (v j) = density c hc) :
    ∑ j, relativeDerivation (d c hc) j (v j : RF) = genericDensity (d c hc) weightedSource := by
  have h := congrArg (algebraMap (field (d c hc)) RF) hv
  simpa only [map_sum, IntermediateField.algebraMap_apply, deriv_coe, density_coe] using h

end CycleQ2GenericWeightedField
end

