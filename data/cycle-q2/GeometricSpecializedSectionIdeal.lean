import Proposal.GeometricRegularSeedSection

/-!
# The actual specialized section ideal on the seed projective charts

Status: source-only proof draft. No Lean elaboration or independent kernel
replay has been run for this module.

Evaluation of the original universal section ideal preserves the literal
three rows of `M*T`. On every matrix-pivot chart, the already proved
cofactor identities make the specialized ideal principal. Its contraction
to the genuine degree-zero ring is generated by the normalized fraction
constructed in `GeometricRegularSeedSection`.

The actual seed equations, leading unit, and basepoint open are recovered
from the original etale incidence point and its seed specialization. Thus
the final chart-cover assertion supplies its hypotheses internally. The
identification with a scheme-theoretic base-change fiber and flatness over
the parameter base are separate constructions.

The geometric strategy is due to Ben Diamond and the collaborators cited
in solution.md. Prepared for fqlx with OpenAI ChatGPT assistance.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2SpecializedSectionIdeal

open CategoryTheory AlgebraicGeometry MvPolynomial Matrix HomogeneousLocalization
open CycleQ2IncidenceNormalForm CycleQ2IncidenceEquations
  CycleQ2IncidenceUniversalChart CycleQ2IncidenceImageLine
  CycleQ2GeometricIncidenceProj CycleQ2IncidenceGenericPointSemantics
  CycleQ2IncidencePolynomialRelations CycleQ2IncidenceCoefficientRelations
  CycleQ2SegreGenericSection CycleQ2GenericLinearSection
  CycleQ2UniversalCurveSection CycleQ2GradedLocalizationProjection
  CycleQ2UniversalCurveCartier CycleQ2RegularSeedSection

variable (y : ParameterIndex → ℂ)

/-- The ideal of the same three rows after fixing the section coefficients. -/
def specializedSectionIdeal (t : Fin 3 → ℂ) : Ideal (PointSurface y) :=
  Ideal.span (Set.range (constantEquation y t))

theorem specializedSectionIdeal_homogeneous (t : Fin 3 → ℂ) :
    (specializedSectionIdeal y t).IsHomogeneous (surfaceGrade y) := by
  apply Ideal.homogeneous_span
  rintro a ⟨i, rfl⟩
  exact ⟨14, constantEquation_homogeneous y t i⟩

/-- Specializing the existing universal polynomial ideal gives exactly
the three-row ideal in the original surface quotient. -/
theorem specializedSectionIdeal_eq_map (t : Fin 3 → ℂ) :
    specializedSectionIdeal y t =
      (genericSectionIdeal y).map
        ((Ideal.Quotient.mk (pointEquations y)).comp
          (MvPolynomial.map (MvPolynomial.eval t))) := by
  rw [specializedSectionIdeal, genericSectionIdeal, Ideal.map_span]
  congr 1
  ext a
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨genericSectionEquation y i, ⟨i, rfl⟩,
      constantEquation_eq_specialization y t i⟩
  · rintro ⟨b, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, (constantEquation_eq_specialization y t i).symm⟩

theorem constantEquation_localize_row (t : Fin 3 → ℂ)
    (p : CycleQ2SegreCech.Chart) (i : Fin 3) :
    algebraMap (PointSurface y) (CoefficientPivot y p) (constantEquation y t i) =
      ∑ j, t j • localizedMatrix y p i j := by
  change (IsScalarTower.toAlgHom ℂ (PointSurface y) (CoefficientPivot y p))
      (∑ j, t j • basePivot y (i, j)) = _
  simp only [map_sum, map_smul]
  rfl

def pivotEvaluation (t : Fin 3 → ℂ) (p : CycleQ2SegreCech.Chart) :
    MvPolynomial (Fin 3) (CoefficientPivot y p) →+* CoefficientPivot y p :=
  MvPolynomial.eval (fun j => algebraMap ℂ (CoefficientPivot y p) (t j))

theorem pivotEvaluation_sectionVector (t : Fin 3 → ℂ)
    (p : CycleQ2SegreCech.Chart) (i : Fin 3) :
    pivotEvaluation y t p (sectionVector (localizedMatrix y p) i) =
      algebraMap (PointSurface y) (CoefficientPivot y p) (constantEquation y t i) := by
  rw [constantEquation_localize_row]
  simp only [pivotEvaluation, sectionVector, linearForm, map_sum, map_mul,
    MvPolynomial.eval_C, MvPolynomial.eval_X, Algebra.smul_def, mul_comm]

theorem specializedSectionIdeal_localize (t : Fin 3 → ℂ)
    (p : CycleQ2SegreCech.Chart) :
    (specializedSectionIdeal y t).map
        (algebraMap (PointSurface y) (CoefficientPivot y p)) =
      (sectionIdeal (localizedMatrix y p)).map (pivotEvaluation y t p) := by
  rw [specializedSectionIdeal, sectionIdeal, Ideal.map_span, Ideal.map_span]
  congr 1
  ext a
  constructor
  · rintro ⟨b, ⟨i, rfl⟩, rfl⟩
    exact ⟨sectionVector (localizedMatrix y p) i, ⟨i, rfl⟩,
      pivotEvaluation_sectionVector y t p i⟩
  · rintro ⟨b, ⟨i, rfl⟩, rfl⟩
    exact ⟨constantEquation y t i, ⟨i, rfl⟩,
      (pivotEvaluation_sectionVector y t p i).symm⟩

/-- Evaluation preserves the rank-one principal-ideal identity. No
regularity assumption on the selected coefficient vector is used here. -/
theorem ordinarySpecializedIdeal_principal (t : Fin 3 → ℂ)
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) (p : CycleQ2SegreCech.Chart) :
    (specializedSectionIdeal y t).map
        (algebraMap (PointSurface y) (CoefficientPivot y p)) =
      Ideal.span {algebraMap (PointSurface y) (CoefficientPivot y p)
        (constantEquation y t p.1)} := by
  rw [specializedSectionIdeal_localize]
  obtain ⟨u, hu'⟩ := localizedMatrix_pivot_isUnit y p
  have hc := @CycleQ2SegreCech.cofactors_map_zero
    (PointSurface y) (inferInstance : CommRing (PointSurface y))
    (CoefficientPivot y p) (inferInstance : CommRing (CoefficientPivot y p))
    (algebraMap (PointSurface y) (CoefficientPivot y p))
    (CycleQ2IncidenceBasepointOpen.curveMatrix (pointMap y))
    (curveMatrix_cofactors y he hu)
  rw [sectionIdeal_principal (localizedMatrix y p) hc p u hu',
    Ideal.map_span, Set.image_singleton]
  change Ideal.span {pivotEvaluation y t p (sectionVector (localizedMatrix y p) p.1)} = _
  rw [pivotEvaluation_sectionVector]

theorem ordinarySpecializedIdeal_principal_fraction (t : Fin 3 → ℂ)
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) (p : CycleQ2SegreCech.Chart) :
    (specializedSectionIdeal y t).map
        (algebraMap (PointSurface y) (CoefficientPivot y p)) =
      Ideal.span {(constantProjectiveEquation y t p).val} := by
  rw [ordinarySpecializedIdeal_principal y t he hu p,
    ← constantProjectiveEquation_val_mul,
    Ideal.span_singleton_mul_right_unit
      (IsLocalization.Away.algebraMap_isUnit (basePivot y p))]

/-- The actual chart ideal obtained by localizing the homogeneous
specialized ideal and taking its degree-zero contraction. -/
def projectiveSpecializedIdeal (t : Fin 3 → ℂ) (p : CycleQ2SegreCech.Chart) :
    Ideal (ConstantProjectivePivot y p) :=
  ((specializedSectionIdeal y t).map
      (algebraMap (PointSurface y) (CoefficientPivot y p))).comap
    (algebraMap (ConstantProjectivePivot y p) (CoefficientPivot y p))

/-- The three original specialized equations cut out the principal ideal
of the exact normalized equation in the genuine projective chart ring. -/
theorem projectiveSpecializedIdeal_principal (t : Fin 3 → ℂ)
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) (p : CycleQ2SegreCech.Chart) :
    projectiveSpecializedIdeal y t p = Ideal.span {constantProjectiveEquation y t p} := by
  rw [projectiveSpecializedIdeal, ordinarySpecializedIdeal_principal_fraction y t he hu p]
  exact principalIdeal_comap_val (surfaceGrade y)
    (basePivot_homogeneous y p) (constantProjectiveEquation y t p)

def constantPivotOpen (p : CycleQ2SegreCech.Chart) : (surface y).Opens :=
  Proj.basicOpen (surfaceGrade y) (basePivot y p)

theorem constantPivotOpen_isAffineOpen (p : CycleQ2SegreCech.Chart) :
    IsAffineOpen (constantPivotOpen y p) :=
  Proj.isAffineOpen_basicOpen (surfaceGrade y) (basePivot y p)
    (basePivot_homogeneous y p) (by decide)

theorem constantPivotOpen_cover
    (hb : IsUnit (aeval y CycleQ2IncidenceBasepointOpen.basepointPolynomial)) :
    (⨆ p : CycleQ2SegreCech.Chart, constantPivotOpen y p) = ⊤ := by
  apply top_unique
  intro x hx
  obtain ⟨i, j, hij⟩ := CycleQ2IncidenceBasepointOpen.specialized_prime_pivot_cover
    (pointMap y) hb x.asHomogeneousIdeal.toIdeal (surface_coordinate_exists y x)
  apply TopologicalSpace.Opens.mem_iSup.mpr
  refine ⟨(i, j), ?_⟩
  change basePivot y (i, j) ∉ x.asHomogeneousIdeal.toIdeal
  exact hij

theorem exists_regular_principal_specialization
    (he : ∀ q, aeval y ((presentation ℂ 57).equation q) = 0)
    (hu : IsUnit (aeval y (leadingProduct ℂ))) :
    ∃ t : Fin 3 → ℂ, t ≠ 0 ∧
      ∀ p : CycleQ2SegreCech.Chart,
        IsSMulRegular (ConstantProjectivePivot y p) (constantProjectiveEquation y t p) ∧
        projectiveSpecializedIdeal y t p = Ideal.span {constantProjectiveEquation y t p} := by
  obtain ⟨t, ht, hreg⟩ := exists_regular_projective_equations y
  exact ⟨t, ht, fun p => ⟨hreg p, projectiveSpecializedIdeal_principal y t he hu p⟩⟩

section LiteralSeed

open CycleQ2IncidenceEtaleParameter CycleQ2IncidenceTraceGeometry

private theorem seedMap_complex (a : ℂ) :
    seedMap (algebraMap ℂ ParameterAlgebra a) = a := by
  rw [IsScalarTower.algebraMap_apply ℂ CycleQ2IncidenceTraceFamily.TraceRing ParameterAlgebra,
    seedMap_algebraMap]
  simp [CycleQ2IncidenceTraceFamily.seedEvaluation]

private theorem seedMap_polynomial (p : ParameterPolynomial ℂ) :
    seedMap (aeval incidencePoint p) = eval (seedPoint (57 : ℂ) Complex.I) p := by
  have h : seedMap.comp (aeval incidencePoint).toRingHom =
      eval (seedPoint (57 : ℂ) Complex.I) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      change seedMap (aeval incidencePoint (C a)) =
        eval (seedPoint (57 : ℂ) Complex.I) (C a)
      rw [aeval_C, eval_C]
      exact seedMap_complex a
    · intro j
      change seedMap (aeval incidencePoint (X j)) =
        eval (seedPoint (57 : ℂ) Complex.I) (X j)
      rw [aeval_X, eval_X]
      exact seedMap_incidencePoint j
  exact RingHom.congr_fun h p

theorem seed_original_equations (q : ColumnIndex) :
    aeval (seedPoint (57 : ℂ) Complex.I) ((presentation ℂ 57).equation q) = 0 := by
  change eval (seedPoint (57 : ℂ) Complex.I) ((presentation ℂ 57).equation q) = 0
  have he := tracePoint_original_equations splitting.P splitting.B _ sliceCoordinate
    incidence_isTracePoint q
  rw [← seedMap_polynomial, he, map_zero]

theorem seed_leading_unit :
    IsUnit (aeval (seedPoint (57 : ℂ) Complex.I) (leadingProduct ℂ)) := by
  change IsUnit (eval (seedPoint (57 : ℂ) Complex.I) (leadingProduct ℂ))
  have h := (tracePoint_leading_unit splitting.P splitting.B _ sliceCoordinate
    incidence_isTracePoint).map seedMap
  rw [seedMap_polynomial] at h
  exact h

theorem seed_basepoint_unit :
    IsUnit (aeval (seedPoint (57 : ℂ) Complex.I)
      CycleQ2IncidenceBasepointOpen.basepointPolynomial) := by
  change IsUnit (eval (seedPoint (57 : ℂ) Complex.I)
    CycleQ2IncidenceBasepointOpen.basepointPolynomial)
  have h := (tracePoint_extra_unit splitting.P splitting.B _ sliceCoordinate
    incidence_isTracePoint).map seedMap
  rw [seedMap_polynomial] at h
  exact h

/-- On the original seed surface, one shared nonzero coefficient vector
gives regular principal ideals on a covering by its nine original pivot
charts. No incidence, basepoint, or regularity premise is supplied. -/
theorem exists_seed_regular_principal_cover :
    ∃ t : Fin 3 → ℂ, t ≠ 0 ∧
      (⨆ p : CycleQ2SegreCech.Chart,
        constantPivotOpen (seedPoint (57 : ℂ) Complex.I) p) = ⊤ ∧
      ∀ p : CycleQ2SegreCech.Chart,
        IsSMulRegular (ConstantProjectivePivot (seedPoint (57 : ℂ) Complex.I) p)
          (constantProjectiveEquation (seedPoint (57 : ℂ) Complex.I) t p) ∧
        projectiveSpecializedIdeal (seedPoint (57 : ℂ) Complex.I) t p =
          Ideal.span {constantProjectiveEquation (seedPoint (57 : ℂ) Complex.I) t p} := by
  obtain ⟨t, ht, hreg⟩ := exists_regular_principal_specialization
    (seedPoint (57 : ℂ) Complex.I) seed_original_equations seed_leading_unit
  exact ⟨t, ht, constantPivotOpen_cover (seedPoint (57 : ℂ) Complex.I)
    seed_basepoint_unit, hreg⟩

end LiteralSeed

