import Proposal.GeometricIncidenceProjectiveProper
import Proposal.GeometricSpecializedProjectiveCurve

/-!
# Properness of the original incidence surface family

Status: source-only proof draft. No elaboration or kernel replay was run.

The original weighted surface quotient is finite type over its coefficient
ring. Its degree-zero part is a quotient of that same coefficient ring,
because all five weights are positive. Consequently the existing
surfaceToBase is a composite of two proper morphisms: Proj.toSpecZero and
the spectrum map of the surjective coefficient homomorphism.

The statement applies to the full original incidence parameter family,
including singular fibers, and to every actual base change. The genuine
specialized closed projective curve constructed earlier is also proper.
No smoothness, flatness, nonemptiness, or fiber-identification premise is
supplied, and none of these additional properties is asserted here.

The geometric strategy is due to Ben Diamond and the collaborators cited
in solution.md. Prepared for fqlx with OpenAI ChatGPT assistance.
-/

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace CycleQ2IncidenceSurfaceProper

open CategoryTheory AlgebraicGeometry MvPolynomial
open CycleQ2IncidenceNormalForm CycleQ2IncidenceUniversalChart CycleQ2IncidenceImageLine
  CycleQ2GeometricIncidenceProj CycleQ2IncidenceProjectiveProper

variable {S : Type} [CommRing S] [Algebra ℂ S]

/-- The exact coefficient map used by surfaceToBase is surjective onto
the degree-zero part, even for a degenerate parameter specialization. -/
theorem surfaceCoefficient_surjective (y : ParameterIndex → S) :
    Function.Surjective (surfaceCoefficient y) := by
  rintro ⟨q, hq⟩
  obtain ⟨p, hp, rfl⟩ := hq
  refine ⟨p.coeff 0, ?_⟩
  apply Subtype.ext
  change Ideal.Quotient.mk (pointEquations y) (C (p.coeff 0)) =
    Ideal.Quotient.mk (pointEquations y) p
  exact congrArg (Ideal.Quotient.mk (pointEquations y))
    (polynomialGrade_zero_eq_C p hp).symm

theorem surfaceCoefficient_spec_closedImmersion (y : ParameterIndex → S) :
    IsClosedImmersion (Spec.map (CommRingCat.ofHom (surfaceCoefficient y))) :=
  IsClosedImmersion.spec_of_surjective _ (surfaceCoefficient_surjective y)

theorem surfaceCoefficient_spec_proper (y : ParameterIndex → S) :
    IsProper (Spec.map (CommRingCat.ofHom (surfaceCoefficient y))) := by
  letI := surfaceCoefficient_spec_closedImmersion y
  infer_instance

/-- The unchanged homogeneous quotient is generated by the five
original coordinates over its coefficient ring. -/
theorem surface_finiteType_coefficients (y : ParameterIndex → S) :
    Algebra.FiniteType S (PointSurface y) := by
  infer_instance

theorem surface_finiteType_zero (y : ParameterIndex → S) :
    Algebra.FiniteType (surfaceGrade y 0) (PointSurface y) := by
  letI : IsScalarTower S (surfaceGrade y 0) (PointSurface y) :=
    IsScalarTower.of_algebraMap_eq' rfl
  letI := surface_finiteType_coefficients y
  exact Algebra.FiniteType.of_restrictScalars_finiteType
    S (surfaceGrade y 0) (PointSurface y)

theorem surface_toSpecZero_proper (y : ParameterIndex → S) :
    IsProper (Proj.toSpecZero (surfaceGrade y)) := by
  letI := surface_finiteType_zero y
  infer_instance

/-- Properness of the existing surface morphism to its original
parameter ring; no geometric property of a fiber is assumed. -/
theorem surfaceToBase_proper (y : ParameterIndex → S) :
    IsProper (surfaceToBase y) := by
  letI := surface_toSpecZero_proper y
  letI := surfaceCoefficient_spec_proper y
  change IsProper (Proj.toSpecZero (surfaceGrade y) ≫
    Spec.map (CommRingCat.ofHom (surfaceCoefficient y)))
  infer_instance

/-- Every scheme-theoretic base change of the original surface
family is proper, including each residue-field fiber. -/
theorem surface_baseChange_proper (y : ParameterIndex → S)
    (T : Scheme) (f : T ⟶ Spec (CommRingCat.of S)) :
    IsProper (Limits.pullback.snd (surfaceToBase y) f) := by
  letI := surfaceToBase_proper y
  infer_instance

theorem fixed_surfaceToBase_proper :
    IsProper (surfaceToBase CycleQ2IncidenceEtaleParameter.incidencePoint) :=
  surfaceToBase_proper CycleQ2IncidenceEtaleParameter.incidencePoint

open CycleQ2SpecializedProjectiveCurve

/-- The already constructed closed specialized subscheme is proper
over the complex coefficient field, whether or not it is empty. -/
theorem specializedCurveToBase_proper (y : ParameterIndex → ℂ) (t : Fin 3 → ℂ) :
    IsProper (specializedCurveToBase y t) := by
  letI := surfaceToBase_proper y
  change IsProper (specializedCurveToSurface y t ≫ surfaceToBase y)
  infer_instance

end CycleQ2IncidenceSurfaceProper

#print axioms CycleQ2IncidenceSurfaceProper.surfaceCoefficient_surjective
#print axioms CycleQ2IncidenceSurfaceProper.surfaceToBase_proper
#print axioms CycleQ2IncidenceSurfaceProper.fixed_surfaceToBase_proper
#print axioms CycleQ2IncidenceSurfaceProper.specializedCurveToBase_proper

end
