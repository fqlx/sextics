import Proposal.GeometricProtectedPencilEvaluation
import Proposal.GeometricProtectedPencilDescent
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# The protected fixed field is the weighted pencil function field

The weighted quotient ring evaluates in the original affine function field.
Its image generates precisely the fixed field of the original sign involution.
Every protected rational function has an expression a + b X₂ over the
weighted field. Multiplication by the sign conjugate gives its inverse.
Prepared for fqlx with OpenAI ChatGPT assistance. See solution.md.
-/

set_option autoImplicit false
set_option Elab.async false
noncomputable section
namespace CycleQ2ProtectedPencilFixedField

open CycleQ2AffineWeightedTransfer CycleQ2AffineHypersurface CycleQ2ProtectedPencilAction
  CycleQ2ProtectedPencilDescent CycleQ2ProtectedPencilEvaluation CycleQ2ProtectedPencilParameter
  MvPolynomial

local instance : Algebra Coeff CycleQ2AffineWeightedTransfer.K := pencilAlgebra
local instance : CharZero CycleQ2AffineWeightedTransfer.K :=
  charZero_of_injective_algebraMap (algebraMap ℂ _).injective

/-- The function subfield generated by the evaluated original weighted quotient. -/
def weightedField : IntermediateField ℂ CycleQ2AffineWeightedTransfer.K :=
  IntermediateField.adjoin ℂ (Set.range weighted)

private theorem polynomial_mem (p : PolyRing) : weightedPolynomial p ∈ weightedField :=
  IntermediateField.subset_adjoin ℂ _ ⟨CycleQ2ProtectedGenericPencilModel.quotient p, rfl⟩

theorem coordinate_mem (i : Fin 5) : weightedCoordinates i ∈ weightedField :=
  (aeval_X weightedCoordinates i : weightedPolynomial (X i) = _ ) ▸ polynomial_mem (X i)

private theorem weighted_C (r : RatFunc ℂ) : weightedPolynomial (C r) = evaluation r :=
  aeval_C weightedCoordinates r

theorem coefficient_mem (r : RatFunc ℂ) : evaluation r ∈ weightedField :=
  weighted_C r ▸ polynomial_mem (C r)

private theorem coefficient_fixed (r : RatFunc ℂ) : beta (evaluation r) = evaluation r := by
  have hp (p : Polynomial ℂ) : beta (Polynomial.aeval parameter p) = Polynomial.aeval parameter p := by
    have h := (AlgHom.congr_fun (Polynomial.aeval_algHom beta.toAlgHom parameter) p).symm
    simpa only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, beta_parameter] using h
  rw [← RatFunc.num_div_denom r, map_div₀, evaluation_polynomial, evaluation_polynomial,
    map_div₀, hp, hp]

private theorem beta_u : beta u = -u := by simp [u, beta_coordinate, betaScale]

private theorem coord_fixed (i : Fin 5) : beta (weightedCoordinates i) = weightedCoordinates i := by
  fin_cases i <;> simp [weightedCoordinates, beta_coordinate, betaScale, beta_u]

theorem weightedField_le : weightedField ≤ betaFixed := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro _ ⟨q,rfl⟩
  obtain ⟨p,rfl⟩ := Ideal.Quotient.mk_surjective q
  change beta (weightedPolynomial p) = weightedPolynomial p
  induction p using MvPolynomial.induction_on with
  | C c => rw [weighted_C]; exact coefficient_fixed c
  | add p q hp hq => rw [map_add, map_add, hp, hq]
  | mul_X p i hp =>
    change beta (weightedPolynomial (p * X i)) = _
    rw [map_mul, map_mul, hp, show weightedPolynomial (X i) = _ from aeval_X weightedCoordinates i]
    exact congrArg (weightedPolynomial p * ·) (coord_fixed i)

private def Represents (x : CycleQ2AffineWeightedTransfer.K) : Prop :=
  ∃ a ∈ weightedField, ∃ b ∈ weightedField, x = a + b * u

private theorem represents_member {x} (hx : x ∈ weightedField) : Represents x :=
  ⟨x,hx,0,weightedField.zero_mem,by ring⟩

private theorem represents_u : Represents u := ⟨0,weightedField.zero_mem,1,weightedField.one_mem,by ring⟩

private theorem represents_add {x y} (hx : Represents x) (hy : Represents y) : Represents (x+y) := by
  obtain ⟨a,ha,b,hb,rfl⟩ := hx
  obtain ⟨c,hc,d,hd,rfl⟩ := hy
  exact ⟨a+c,weightedField.add_mem ha hc,b+d,weightedField.add_mem hb hd,by ring⟩

private theorem represents_mul {x y} (hx : Represents x) (hy : Represents y) : Represents (x*y) := by
  obtain ⟨a,ha,b,hb,rfl⟩ := hx
  obtain ⟨c,hc,d,hd,rfl⟩ := hy
  have h₂ : u^2 ∈ weightedField := coordinate_mem 4
  exact ⟨a*c+b*d*u^2,weightedField.add_mem (weightedField.mul_mem ha hc)
    (weightedField.mul_mem (weightedField.mul_mem hb hd) h₂),a*d+b*c,
    weightedField.add_mem (weightedField.mul_mem ha hd) (weightedField.mul_mem hb hc),by ring⟩

private theorem represents_beta {x} (hx : Represents x) : Represents (beta x) := by
  obtain ⟨a,ha,b,hb,rfl⟩ := hx
  refine ⟨a,ha,-b,weightedField.neg_mem hb,?_⟩
  rw [map_add, map_mul, (mem_betaFixed a).mp (weightedField_le ha),
    (mem_betaFixed b).mp (weightedField_le hb), beta_u]
  ring

private theorem fixed_representative {x} (hx : Represents x) (he : beta x = x) : x ∈ weightedField := by
  obtain ⟨a,ha,b,hb,rfl⟩ := hx
  rw [map_add, map_mul, (mem_betaFixed a).mp (weightedField_le ha),
    (mem_betaFixed b).mp (weightedField_le hb), beta_u, mul_neg] at he
  rw [CharZero.neg_eq_self_iff.mp (add_left_cancel he), add_zero]
  exact ha

private theorem represents_inv {x} (hx : Represents x) : Represents x⁻¹ := by
  by_cases h : x = 0
  · simpa [h] using represents_member weightedField.zero_mem
  have hσ : beta x ≠ 0 := (map_ne_zero beta).mpr h
  have hn : x * beta x ∈ weightedField :=
    fixed_representative (represents_mul hx (represents_beta hx)) (by
      rw [map_mul, beta_involutive x, mul_comm])
  rw [show x⁻¹ = beta x * (x * beta x)⁻¹ by field_simp [h,hσ]]
  exact represents_mul (represents_beta hx) (represents_member (weightedField.inv_mem hn))

private theorem represents_z (i : Fin 5) : Represents (z i) := by
  fin_cases i
  · exact represents_member (coordinate_mem 1)
  · exact represents_u
  · exact represents_member (coordinate_mem 2)
  · exact represents_member (coordinate_mem 3)
  · change Represents v
    rw [← parameter_mul_u]
    exact represents_mul (represents_member (evaluation_X ▸ coefficient_mem RatFunc.X)) represents_u

private theorem represents_affineMap (p : HodgeComputer.AmbientPoly 4) : Represents (affineMap p) := by
  induction p using MvPolynomial.induction_on with
  | C c => exact represents_member (weightedField.algebraMap_mem c)
  | add p q hp hq => rw [map_add]; exact represents_add hp hq
  | mul_X p i hp => rw [map_mul]; exact represents_mul hp (represents_z i)

/-- An explicit quadratic expression for every element of the original field. -/
theorem quadratic_expression (x : CycleQ2AffineWeightedTransfer.K) :
    ∃ a ∈ weightedField, ∃ b ∈ weightedField, x = a + b * u := by
  obtain ⟨a,b,_,rfl⟩ := IsFractionRing.div_surjective AffineCoordinateRing x
  obtain ⟨p,rfl⟩ := affineProjection_surjective a
  obtain ⟨q,rfl⟩ := affineProjection_surjective b
  change Represents (affineMap p / affineMap q)
  rw [div_eq_mul_inv]
  exact represents_mul (represents_affineMap p) (represents_inv (represents_affineMap q))

/-- Descent under the protected sign involution lands in exactly the function
field generated by the generic weighted pencil's evaluated coordinate ring. -/
theorem weightedField_eq_betaFixed : weightedField = betaFixed :=
  le_antisymm weightedField_le (fun x hx => fixed_representative (quadratic_expression x) hx)

/-- The original coordinate X₂ generates a nontrivial quadratic extension. -/
theorem u_not_mem_weightedField : u ∉ weightedField := by
  intro hu
  exact u_ne_zero (CharZero.neg_eq_self_iff.mp (beta_u.symm.trans
    ((mem_betaFixed u).mp (weightedField_le hu))))

/-- The protected residue source is defined over the function field of the
evaluated weighted pencil, with the normalization of the original four-form. -/
theorem exists_weighted_residue_source :
    ∃ τ : ⋀[weightedField]^4 (KaehlerDifferential ℂ weightedField),
      CycleQ2ExteriorSectionNaturality.exteriorDifferentialMap weightedField.val 4 τ =
        CycleQ2AffineExactness.residueSourceForm CycleQ2AffineClearing.affineA := by
  rw [weightedField_eq_betaFixed]
  exact ⟨descendedSource, descendedSource_pullback⟩

end CycleQ2ProtectedPencilFixedField
end

#print axioms CycleQ2ProtectedPencilFixedField.quadratic_expression
#print axioms CycleQ2ProtectedPencilFixedField.weightedField_eq_betaFixed

#print axioms CycleQ2ProtectedPencilFixedField.exists_weighted_residue_source
