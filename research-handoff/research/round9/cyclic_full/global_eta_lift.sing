ring R=0,(L,r,x),dp;
option(redSB);short=0;
ideal I=661500*L^3*x^2 + 3889620*L^2*r^2*x^2 - 9375*L^2*r*x^3 - 1323000*L^2*r*x^2 + 28125*L^2*x^2 + 79625*L*r^3*x^3 - 1728720*L*r^3*x^2 + 3125*L*r^2*x^3 + 165375*L*r^2*x^2 + 192080*r^5*x^3 - 110250*r^4*x^3 + 6250*r^3*x^3 + 110250*r^3*x^2,7779240*L^3*x - 3889620*L^2*r*x - 28125*L^2*x^2 - 992250*L^2*x - 576240*L*r^3*x^2 + 6250*L*r^2*x^3 + 385875*L*r^2*x^2 + 9375*L*r*x^2 + 496125*L*r*x + 12250*r^4*x^3 + 576240*r^4*x^2 - 6250*r^3*x^3 - 257250*r^3*x^2,-6482700*L^2*r*x + 28125*L^2*x^2 + 1323000*L^2*x + 55125*L*r^2*x^2 + 5186160*L*r^2*x - 9375*L*r*x^2 - 496125*L*r*x + 192080*r^4*x^2 - 61250*r^3*x^2 - 6250*r^2*x^2 - 330750*r^2*x,330750*L^2*x + 11668860*L^2 + 5186160*L*r^2*x - 18750*L*r*x^2 - 1157625*L*r*x - 28125*L*x - 1488375*L + 12250*r^3*x^2 - 1728720*r^3*x + 6250*r^2*x^2 + 330750*r^2*x,3889620*L^2 - 165375*L*r*x - 15558480*L*r + 28125*L*x + 1488375*L - 2881200*r^3*x + 12500*r^2*x^2 + 771750*r^2*x + 18750*r*x + 992250*r,-2778300*L^3*x - 7260624*L^2*r^2*x + 3704400*L^2*r*x - 118125*L^2*x - 411600*L*r^3*x^2 - 1075648*r^5*x^2 + 548800*r^4*x^2 - 17500*r^3*x^2,-32672808*L^3 - 463050*L^2*r*x + 118125*L^2*x + 4167450*L^2 - 4840416*L*r^3*x - 68600*r^4*x^2 + 17500*r^3*x^2 + 617400*r^3*x,21781872*L^2*r - 118125*L^2*x - 5556600*L^2 + 3226944*r^4*x - 17500*r^3*x^2 - 823200*r^3*x,992250*L^3*x + 11668860*L^3 + 2593080*L^2*r^2*x - 1157625*L^2*r*x - 1488375*L^2 + 147000*L*r^3*x^2 + 1728720*L*r^3*x + 384160*r^5*x^2 - 171500*r^4*x^2 - 220500*r^3*x,11668860*L^3 + 165375*L^2*r*x - 7779240*L^2*r + 496125*L^2 + 1728720*L*r^3*x + 24500*r^4*x^2 - 1152480*r^4*x + 73500*r^3*x;
ideal G=std(I);
poly d=x*(27*L^2 + 4*r^3*x)*(50824368*L^2 + 4321800*L*r*x - 15625*L*x^2 - 1102500*L*x - 12965400*L + 7529536*r^3*x - 30625*r^2*x^2 - 5762400*r^2*x + 15625*r*x^2 + 918750*r*x + 15625*x + 826875);
for(int j=1;j<=3;j++){print("POWER");print(j);poly target=d^j;poly rr=reduce(target,G);print(rr);if(rr==0){matrix T=lift(I,ideal(target));print("LIFT_BEGIN");for(int i=1;i<=10;i++){print("COEFFICIENT "+string(i));print(T[i,1]);}print("LIFT_END");break;}}
quit;
