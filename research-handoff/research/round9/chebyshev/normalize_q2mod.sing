ring R=173,(h,s),dp;
poly f=(1445900625/16)*h^16+(-12675/2)*h^15+(-39039316873/18)*h^14+(-2471625/8)*h^13*s^1+(152100)*h^13+(65/6)*h^12*s^1+(65065528117/3)*h^12+(12358125/2)*h^11*s^1+(-1521000)*h^11+(-650/3)*h^10*s^1+(-347016149920/3)*h^10+(-49432500)*h^9*s^1+(8112000)*h^9+(5200/3)*h^8*s^1+(3123145348720/9)*h^8+(325/648)*h^7*s^3+(197730000)*h^7*s^1+(-24336000)*h^7+(-20800/3)*h^6*s^1+(-1665677518720/3)*h^6+(-319/54)*h^5*s^3+(-395460000)*h^5*s^1+(38937600)*h^5+(-1/11664)*h^4*s^4+(41600/3)*h^4*s^1+(1110451677952/3)*h^4+(626/27)*h^3*s^3+(316368000)*h^3*s^1+(-25958400)*h^3+(1/1458)*h^2*s^4+(-33280/3)*h^2*s^1+(4096/9)*h^2+(-1/3)*h^1*s^4+(-2456/81)*h^1*s^3+(1)*s^6+(-1/729)*s^4;
