poly pp=72*U^6*v1^3*v0^2+68*U^6*v1*v0^4+106*U^2*z^4*v1*v0^4*h1^4*h0^4*q0^8+24*U^2*z^4*v1*v0^4*h1^2*h0^6*q0^8+17*U^2*z^4*v1*v0^4*h1*h0^7*q1^5*q0^3+61*U^2*z^4*v1*v0^4*h0^8*q0^8+52*z^6*v0^5*h1^7*h0^5*q1^6*q0^6+52*z^6*v0^5*h1^7*h0^5*q0^12+30*z^6*v0^5*h1^5*h0^7*q1^6*q0^6+25*z^6*v0^5*h1^5*h0^7*q1^4*q0^8+30*z^6*v0^5*h1^5*h0^7*q0^12+98*z^6*v0^5*h1^3*h0^9*q1^6*q0^6+18*z^6*v0^5*h1^3*h0^9*q1^4*q0^8+98*z^6*v0^5*h1^3*h0^9*q0^12+51*z^6*v0^5*h1*h0^11*q1^6*q0^6+73*z^6*v0^5*h1*h0^11*q1^4*q0^8+51*z^6*v0^5*h1*h0^11*q0^12;
poly aa=106*z^4*v0^4*h1^4*h0^4*q0^8+24*z^4*v0^4*h1^2*h0^6*q0^8+17*z^4*v0^4*h1*h0^7*q1^5*q0^3+61*z^4*v0^4*h0^8*q0^8;
