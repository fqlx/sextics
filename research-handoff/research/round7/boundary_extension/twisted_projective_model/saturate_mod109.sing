LIB "elim.lib";
option(redSB);
ring R=109,(U,t,z,v1,v0,h1,h0,q1,q0),wp(5,12,1,1,1,1,1,1,1);
ideal JJ=1*U^6*v1^4+76*U^6*v1^2*v0^2+3*U^4*t*v1^2+56*U^2*z^4*v1*v0^3*h1^5*h0^3*q1^6*q0^2+56*U^2*z^4*v1*v0^3*h1^5*h0^3*q0^8+97*U^2*z^4*v1*v0^3*h1^3*h0^5*q1^6*q0^2+97*U^2*z^4*v1*v0^3*h1^3*h0^5*q0^8+24*U^2*z^4*v1*v0^3*h1*h0^7*q1^6*q0^2+24*U^2*z^4*v1*v0^3*h1*h0^7*q0^8+75*z^6*v0^4*h1^8*h0^4*q1^12+41*z^6*v0^4*h1^8*h0^4*q1^6*q0^6+75*z^6*v0^4*h1^8*h0^4*q0^12+41*z^6*v0^4*h1^7*h0^5*q1^3*q0^9+81*z^6*v0^4*h1^6*h0^6*q1^12+53*z^6*v0^4*h1^6*h0^6*q1^6*q0^6+81*z^6*v0^4*h1^6*h0^6*q0^12+53*z^6*v0^4*h1^5*h0^7*q1^3*q0^9+3*z^6*v0^4*h1^4*h0^8*q1^12+6*z^6*v0^4*h1^4*h0^8*q1^6*q0^6+3*z^6*v0^4*h1^4*h0^8*q0^12+6*z^6*v0^4*h1^3*h0^9*q1^3*q0^9+105*z^6*v0^4*h1^2*h0^10*q1^12+101*z^6*v0^4*h1^2*h0^10*q1^6*q0^6+105*z^6*v0^4*h1^2*h0^10*q0^12+101*z^6*v0^4*h1*h0^11*q1^3*q0^9,72*U^6*v1^3*v0^2+68*U^6*v1*v0^4+3*U^2*t^2*v1+106*U^2*z^4*v1*v0^4*h1^4*h0^4*q0^8+24*U^2*z^4*v1*v0^4*h1^2*h0^6*q0^8+17*U^2*z^4*v1*v0^4*h1*h0^7*q1^5*q0^3+61*U^2*z^4*v1*v0^4*h0^8*q0^8+56*t*z^4*v0^3*h1^5*h0^3*q1^6*q0^2+56*t*z^4*v0^3*h1^5*h0^3*q0^8+97*t*z^4*v0^3*h1^3*h0^5*q1^6*q0^2+97*t*z^4*v0^3*h1^3*h0^5*q0^8+24*t*z^4*v0^3*h1*h0^7*q1^6*q0^2+24*t*z^4*v0^3*h1*h0^7*q0^8+52*z^6*v0^5*h1^7*h0^5*q1^6*q0^6+52*z^6*v0^5*h1^7*h0^5*q0^12+30*z^6*v0^5*h1^5*h0^7*q1^6*q0^6+25*z^6*v0^5*h1^5*h0^7*q1^4*q0^8+30*z^6*v0^5*h1^5*h0^7*q0^12+98*z^6*v0^5*h1^3*h0^9*q1^6*q0^6+18*z^6*v0^5*h1^3*h0^9*q1^4*q0^8+98*z^6*v0^5*h1^3*h0^9*q0^12+51*z^6*v0^5*h1*h0^11*q1^6*q0^6+73*z^6*v0^5*h1*h0^11*q1^4*q0^8+51*z^6*v0^5*h1*h0^11*q0^12,71*U^6*v1^4*v0^2+37*U^6*v1^2*v0^4+75*U^6*v0^6+1*t^3+106*t*z^4*v0^4*h1^4*h0^4*q0^8+24*t*z^4*v0^4*h1^2*h0^6*q0^8+17*t*z^4*v0^4*h1*h0^7*q1^5*q0^3+61*t*z^4*v0^4*h0^8*q0^8+107*z^6*v0^6*h1^6*h0^6*q0^12+24*z^6*v0^6*h1^4*h0^8*q0^12+17*z^6*v0^6*h1^3*h0^9*q1^5*q0^7+63*z^6*v0^6*h1^2*h0^10*q1^12+63*z^6*v0^6*h1^2*h0^10*q1^6*q0^6+13*z^6*v0^6*h1^2*h0^10*q0^12+41*z^6*v0^6*h1*h0^11*q1^5*q0^7+19*z^6*v0^6*h0^12*q0^12;
poly ff=1*U*z*v1^5*v0*h1^3*h0*q0+105*U*z*v1^5*v0*h1*h0^3*q0+62*U*z*v1^3*v0^3*h1^3*h0*q0+79*U*z*v1^3*v0^3*h1*h0^3*q0+46*U*z*v1*v0^5*h1^3*h0*q0+34*U*z*v1*v0^5*h1*h0^3*q0;
print("TWISTED_SATURATION_START");
ideal II=sat(JJ,ideal(ff));
print("TWISTED_SATURATION_DONE");
print(size(II));
write("/workspace/research/round7/boundary_extension/twisted_projective_model/saturated_mod109.sing",II);
ideal CC=quotient(JJ,II);
print("TWISTED_CANONICAL_COLON_DONE");
write("/workspace/research/round7/boundary_extension/twisted_projective_model/canonical_colon_mod109.sing",CC);
quit;
