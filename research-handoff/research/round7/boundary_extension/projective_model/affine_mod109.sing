LIB "elim.lib";
option(redSB);
ring R=109,(U,t,v,h,q),dp;
ideal JJ=1*U^6*v^4+76*U^6*v^2+3*U^4*t*v^2+56*U^2*v*h^5*q^6+56*U^2*v*h^5+97*U^2*v*h^3*q^6+97*U^2*v*h^3+24*U^2*v*h*q^6+24*U^2*v*h+75*h^8*q^12+41*h^8*q^6+75*h^8+41*h^7*q^3+81*h^6*q^12+53*h^6*q^6+81*h^6+53*h^5*q^3+3*h^4*q^12+6*h^4*q^6+3*h^4+6*h^3*q^3+105*h^2*q^12+101*h^2*q^6+105*h^2+101*h*q^3,72*U^6*v^3+68*U^6*v+3*U^2*t^2*v+106*U^2*v*h^4+24*U^2*v*h^2+17*U^2*v*h*q^5+61*U^2*v+56*t*h^5*q^6+56*t*h^5+97*t*h^3*q^6+97*t*h^3+24*t*h*q^6+24*t*h+52*h^7*q^6+52*h^7+30*h^5*q^6+25*h^5*q^4+30*h^5+98*h^3*q^6+18*h^3*q^4+98*h^3+51*h*q^6+73*h*q^4+51*h,71*U^6*v^4+37*U^6*v^2+75*U^6+1*t^3+106*t*h^4+24*t*h^2+17*t*h*q^5+61*t+107*h^6+24*h^4+17*h^3*q^5+63*h^2*q^12+63*h^2*q^6+13*h^2+41*h*q^5+19;
print("AFFINE_MAIN_SATURATION_START");
ideal II=sat(JJ,ideal(h*(h*h-4)*v*U));
print("AFFINE_MAIN_SATURATION_DONE");
print(size(II));
print(dim(std(II)));
write("/workspace/research/round7/boundary_extension/projective_model/affine_saturated_mod109.sing",II);
quit;
