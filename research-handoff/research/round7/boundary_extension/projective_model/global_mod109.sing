LIB "elim.lib";
option(redSB);
ring R=109,(U,t,z,v1,v0,h1,h0,q1,q0),dp;
ideal JJ=1*U^6*v1^4*h0^8*q0^12+76*U^6*v1^2*v0^2*h0^8*q0^12+3*U^4*t*v1^2*v0^2*h0^8*q0^12+56*U^2*z^4*v1*v0^3*h1^5*h0^3*q1^6*q0^6+56*U^2*z^4*v1*v0^3*h1^5*h0^3*q0^12+97*U^2*z^4*v1*v0^3*h1^3*h0^5*q1^6*q0^6+97*U^2*z^4*v1*v0^3*h1^3*h0^5*q0^12+24*U^2*z^4*v1*v0^3*h1*h0^7*q1^6*q0^6+24*U^2*z^4*v1*v0^3*h1*h0^7*q0^12+75*z^6*v0^4*h1^8*q1^12+41*z^6*v0^4*h1^8*q1^6*q0^6+75*z^6*v0^4*h1^8*q0^12+41*z^6*v0^4*h1^7*h0*q1^3*q0^9+81*z^6*v0^4*h1^6*h0^2*q1^12+53*z^6*v0^4*h1^6*h0^2*q1^6*q0^6+81*z^6*v0^4*h1^6*h0^2*q0^12+53*z^6*v0^4*h1^5*h0^3*q1^3*q0^9+3*z^6*v0^4*h1^4*h0^4*q1^12+6*z^6*v0^4*h1^4*h0^4*q1^6*q0^6+3*z^6*v0^4*h1^4*h0^4*q0^12+6*z^6*v0^4*h1^3*h0^5*q1^3*q0^9+105*z^6*v0^4*h1^2*h0^6*q1^12+101*z^6*v0^4*h1^2*h0^6*q1^6*q0^6+105*z^6*v0^4*h1^2*h0^6*q0^12+101*z^6*v0^4*h1*h0^7*q1^3*q0^9,72*U^6*v1^3*h0^7*q0^6+68*U^6*v1*v0^2*h0^7*q0^6+3*U^2*t^2*v1*v0^2*h0^7*q0^6+106*U^2*z^4*v1*v0^2*h1^4*h0^3*q0^6+24*U^2*z^4*v1*v0^2*h1^2*h0^5*q0^6+17*U^2*z^4*v1*v0^2*h1*h0^6*q1^5*q0+61*U^2*z^4*v1*v0^2*h0^7*q0^6+56*t*z^4*v0^3*h1^5*h0^2*q1^6+56*t*z^4*v0^3*h1^5*h0^2*q0^6+97*t*z^4*v0^3*h1^3*h0^4*q1^6+97*t*z^4*v0^3*h1^3*h0^4*q0^6+24*t*z^4*v0^3*h1*h0^6*q1^6+24*t*z^4*v0^3*h1*h0^6*q0^6+52*z^6*v0^3*h1^7*q1^6+52*z^6*v0^3*h1^7*q0^6+30*z^6*v0^3*h1^5*h0^2*q1^6+25*z^6*v0^3*h1^5*h0^2*q1^4*q0^2+30*z^6*v0^3*h1^5*h0^2*q0^6+98*z^6*v0^3*h1^3*h0^4*q1^6+18*z^6*v0^3*h1^3*h0^4*q1^4*q0^2+98*z^6*v0^3*h1^3*h0^4*q0^6+51*z^6*v0^3*h1*h0^6*q1^6+73*z^6*v0^3*h1*h0^6*q1^4*q0^2+51*z^6*v0^3*h1*h0^6*q0^6,71*U^6*v1^4*h0^6*q0^12+37*U^6*v1^2*v0^2*h0^6*q0^12+75*U^6*v0^4*h0^6*q0^12+1*t^3*v0^4*h0^6*q0^12+106*t*z^4*v0^4*h1^4*h0^2*q0^12+24*t*z^4*v0^4*h1^2*h0^4*q0^12+17*t*z^4*v0^4*h1*h0^5*q1^5*q0^7+61*t*z^4*v0^4*h0^6*q0^12+107*z^6*v0^4*h1^6*q0^12+24*z^6*v0^4*h1^4*h0^2*q0^12+17*z^6*v0^4*h1^3*h0^3*q1^5*q0^7+63*z^6*v0^4*h1^2*h0^4*q1^12+63*z^6*v0^4*h1^2*h0^4*q1^6*q0^6+13*z^6*v0^4*h1^2*h0^4*q0^12+41*z^6*v0^4*h1*h0^5*q1^5*q0^7+19*z^6*v0^4*h0^6*q0^12;
poly ff=1*U*z*v1^5*v0*h1^3*h0*q0+105*U*z*v1^5*v0*h1*h0^3*q0+62*U*z*v1^3*v0^3*h1^3*h0*q0+79*U*z*v1^3*v0^3*h1*h0^3*q0+46*U*z*v1*v0^5*h1^3*h0*q0+34*U*z*v1*v0^5*h1*h0^3*q0;
print("GLOBAL_SATURATION_START");
ideal II=sat(JJ,ideal(ff));
print("GLOBAL_SATURATION_DONE");
print(size(II));
print(dim(std(II)));
write("/workspace/research/round7/boundary_extension/projective_model/saturated_mod109.sing",II);
print("SATURATION_READY_FOR_CANONICAL_EXT");
quit;
